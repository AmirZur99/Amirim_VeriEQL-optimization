{"file": "benchmark/leetcode/raw_data/175.csv", "index": 103, "schema": {"PERSON": {"PERSONID": "INT", "FIRSTNAME": "VARCHAR", "LASTNAME": "VARCHAR"}, "ADDRESS": {"ADDRESSID": "INT", "PERSONID": "INT", "CITY": "VARCHAR", "STATE": "VARCHAR"}}, "constraint": [{"primary": [{"value": "PERSON__PERSONID"}]}, {"primary": [{"value": "ADDRESS__ADDRESSID"}]}, {"primary": [{"value": "ADDRESS__PERSONID"}]}, {"foreign": [{"value": "ADDRESS__PERSONID"}, {"value": "PERSON__PERSONID"}]}], "pair": ["SELECT FIRSTNAME, LASTNAME, CITY, STATE FROM PERSON AS P LEFT OUTER JOIN ADDRESS AS A ON P.PERSONID = A.PERSONID", "SELECT P.LASTNAME, P.FIRSTNAME, IF(EXISTS(SELECT PERSONID FROM ADDRESS WHERE PERSONID = P.PERSONID), (SELECT CITY FROM ADDRESS WHERE PERSONID = P.PERSONID) ,NULL) AS CITY, IF(EXISTS(SELECT PERSONID FROM ADDRESS WHERE PERSONID = P.PERSONID), (SELECT STATE FROM ADDRESS WHERE PERSONID = P.PERSONID) ,NULL) AS STATE FROM PERSON AS P"]}
{"file": "benchmark/leetcode/raw_data/175.csv", "index": 111, "schema": {"PERSON": {"PERSONID": "INT", "FIRSTNAME": "VARCHAR", "LASTNAME": "VARCHAR"}, "ADDRESS": {"ADDRESSID": "INT", "PERSONID": "INT", "CITY": "VARCHAR", "STATE": "VARCHAR"}}, "constraint": [{"primary": [{"value": "PERSON__PERSONID"}]}, {"primary": [{"value": "ADDRESS__ADDRESSID"}]}, {"primary": [{"value": "ADDRESS__PERSONID"}]}, {"foreign": [{"value": "ADDRESS__PERSONID"}, {"value": "PERSON__PERSONID"}]}], "pair": ["SELECT FIRSTNAME, LASTNAME, CITY, STATE FROM PERSON AS P LEFT OUTER JOIN ADDRESS AS A ON P.PERSONID = A.PERSONID", "SELECT T.FIRSTNAME , T.LASTNAME , E.CITY, E.STATE FROM PERSON T LEFT OUTER JOIN ADDRESS E ON T.PERSONID=E.PERSONID WHERE T.PERSONID IN (SELECT PERSONID FROM PERSON GROUP BY PERSONID)"]}
