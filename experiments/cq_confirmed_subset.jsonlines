PNULLABLES__EMPNO"}]}, {"foreign": [{"value": "EMPNULLABLES__DEPTNO"}, {"value": "DEPT__DEPTNO"}]}, {"primary": [{"value": "EMPNULLABLES_20__EMPNO"}]}, {"foreign": [{"value": "EMPNULLABLES_20__DEPTNO"}, {"value": "DEPT__DEPTNO"}]}, {"primary": [{"value": "EMP_B__EMPNO"}]}, {"foreign": [{"value": "EMP_B__DEPTNO"}, {"value": "DEPT__DEPTNO"}]}], "pair": ["SELECT DEPT.DEPTNO, EMP.EMPNO FROM DEPT RIGHT JOIN EMP ON DEPT.DEPTNO = EMP.DEPTNO OFFSET 2 ROWS FETCH NEXT 10 ROWS ONLY", "SELECT DEPT0.DEPTNO, t1.EMPNO FROM DEPT AS DEPT0 RIGHT JOIN (SELECT EMPNO, ENAME, JOB, MGR, HIREDATE, SAL, COMM, DEPTNO, SLACKER FROM EMP OFFSET 2 ROWS FETCH NEXT 10 ROWS ONLY) AS t1 ON DEPT0.DEPTNO = t1.DEPTNO OFFSET 2 ROWS FETCH NEXT 10 ROWS ONLY"], "_source": "calcite", "_gt": "GT_NEQ", "_gt_states": ["EQU", "EQU", "NEQ"]}
