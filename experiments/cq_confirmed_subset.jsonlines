{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 339, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, CASE E.OPERATOR WHEN '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') WHEN '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS AS E, VARIABLES AS V1, VARIABLES AS V2 WHERE E.LEFT_OPERAND = V1.NAME AND E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 343, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN E.OPERATOR = '>' THEN IF(V1.VALUE>V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '=' THEN IF(V1.VALUE=V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '<' THEN IF(V1.VALUE<V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 344, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR='>' THEN IF(V1.VALUE>V2.VALUE,'TRUE','FALSE') WHEN OPERATOR='=' THEN IF(V1.VALUE=V2.VALUE,'TRUE','FALSE') WHEN OPERATOR='<' THEN IF(V1.VALUE<V2.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS JOIN VARIABLES V1 JOIN VARIABLES V2 ON V1.NAME=LEFT_OPERAND AND V2.NAME=RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 347, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND, CASE WHEN VALUE1 > VALUE2 AND OPERATOR = '>' THEN TRUE WHEN VALUE1 > VALUE2 AND OPERATOR = '<' THEN FALSE WHEN VALUE1 > VALUE2 AND OPERATOR = '=' THEN FALSE WHEN VALUE1 < VALUE2 AND OPERATOR = '>' THEN FALSE WHEN VALUE1 < VALUE2 AND OPERATOR = '<' THEN TRUE WHEN VALUE1 < VALUE2 AND OPERATOR = '=' THEN FALSE WHEN VALUE1 = VALUE2 AND OPERATOR = '=' THEN TRUE WHEN VALUE1 = VALUE2 AND OPERATOR = '>' THEN FALSE WHEN VALUE1 = VALUE2 AND OPERATOR = '<' THEN FALSE END VALUE FROM (SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND,V1.VALUE VALUE1,V2.VALUE VALUE2 FROM VARIABLES V1 RIGHT JOIN EXPRESSIONS E1 ON V1.NAME = E1.LEFT_OPERAND LEFT JOIN VARIABLES V2 ON E1.RIGHT_OPERAND = V2.NAME) A"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 351, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE OPERATOR WHEN '>' THEN IF(L.VALUE > R.VALUE, 'TRUE', 'FALSE') WHEN '=' THEN IF(L.VALUE = R.VALUE, 'TRUE', 'FALSE') ELSE IF(L.VALUE < R.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 354, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH TMP AS (SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, V1.VALUE L, V2.VALUE R FROM EXPRESSIONS E INNER JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME INNER JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(L > R, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(L = R, 'TRUE', 'FALSE') ELSE IF(L < R, 'TRUE', 'FALSE') END VALUE FROM TMP"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 358, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE OPERATOR WHEN '>' THEN IF(LFT.VALUE > RGT.VALUE, 'TRUE', 'FALSE') WHEN '<' THEN IF(LFT.VALUE < RGT.VALUE, 'TRUE', 'FALSE') ELSE IF(LFT.VALUE = RGT.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES LFT ON E.LEFT_OPERAND = LFT.NAME JOIN VARIABLES RGT ON E.RIGHT_OPERAND = RGT.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 363, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, IF((CASE WHEN OPERATOR = '>' THEN V1.VALUE > V2.VALUE WHEN OPERATOR = '<' THEN V1.VALUE < V2.VALUE ELSE V1.VALUE = V2.VALUE END) = 1, 'TRUE', 'FALSE') AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 365, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.* ,CASE WHEN E.OPERATOR = '>' THEN IF(L.VALUE > R.VALUE,'TRUE', 'FALSE') WHEN E.OPERATOR = '=' THEN IF(L.VALUE = R.VALUE,'TRUE', 'FALSE') WHEN E.OPERATOR = '<' THEN IF(L.VALUE < R.VALUE,'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 370, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT B.LEFT_OPERAND,B.OPERATOR,B.RIGHT_OPERAND, CASE WHEN B.OPERATOR= '>' THEN IF(A.VALUE>C.VALUE,'TRUE','FALSE') WHEN B.OPERATOR= '<' THEN IF(A.VALUE<C.VALUE,'TRUE','FALSE') WHEN B.OPERATOR= '=' THEN IF(A.VALUE=C.VALUE,'TRUE','FALSE') END AS VALUE FROM VARIABLES A JOIN EXPRESSIONS B ON A.NAME = B.LEFT_OPERAND JOIN VARIABLES C ON C.NAME=B.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 374, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR='>' THEN IF(V1.VALUE > V2.VALUE,'TRUE','FALSE') WHEN OPERATOR='<' THEN IF(V1.VALUE < V2.VALUE,'TRUE','FALSE') WHEN OPERATOR='=' THEN IF(V1.VALUE = V2.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS JOIN VARIABLES V1 ON V1.NAME = LEFT_OPERAND JOIN VARIABLES V2 ON V2.NAME = RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 376, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '=' THEN IF(RIGHT_VALUE = LEFT_VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(RIGHT_VALUE > LEFT_VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(RIGHT_VALUE < LEFT_VALUE, 'TRUE', 'FALSE') END AS VALUE FROM ( SELECT LEFT_OPERAND, LEFT_VALUE, OPERATOR, RIGHT_OPERAND , VALUE AS RIGHT_VALUE FROM ( SELECT T1.LEFT_OPERAND, VALUE AS LEFT_VALUE, OPERATOR, RIGHT_OPERAND FROM ( SELECT * FROM EXPRESSIONS )T1 LEFT JOIN ( SELECT * FROM VARIABLES )T2 ON T1.LEFT_OPERAND = T2.NAME )TT1 LEFT JOIN ( SELECT * FROM VARIABLES )TT2 ON TT1.RIGHT_OPERAND = TT2.NAME )T"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 377, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR = R THEN TRUE ELSE FALSE END) AS VALUE FROM (SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN V1.VALUE > V2.VALUE THEN '>' WHEN V1.VALUE = V2.VALUE THEN '=' ELSE '<' END) AS R FROM EXPRESSIONS E JOIN VARIABLES V1 ON V1.NAME = LEFT_OPERAND JOIN VARIABLES V2 ON V2.NAME = RIGHT_OPERAND) TEMP"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 382, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, (CASE WHEN E.OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '<' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') END) AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON V1.NAME = E.LEFT_OPERAND JOIN VARIABLES V2 ON V2.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 384, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND ,IF((CASE WHEN OPERATOR = '>' THEN (L.VALUE > R.VALUE) WHEN OPERATOR = '<' THEN (L.VALUE < R.VALUE) WHEN OPERATOR = '=' THEN (L.VALUE = R.VALUE) END )=1,'TRUE','FALSE') VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME LEFT JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 385, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '<' THEN IF (V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF (V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF (V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 388, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR,RIGHT_OPERAND, CASE WHEN OPERATOR = '>' AND A.VALUE > B.VALUE THEN TRUE WHEN OPERATOR = '>' AND A.VALUE <= B.VALUE THEN FALSE WHEN OPERATOR = '=' AND A.VALUE = B.VALUE THEN TRUE WHEN OPERATOR = '=' AND A.VALUE != B.VALUE THEN FALSE WHEN OPERATOR = '<' AND A.VALUE < B.VALUE THEN TRUE WHEN OPERATOR = '<' AND A.VALUE >= B.VALUE THEN FALSE ELSE NULL END AS VALUE FROM EXPRESSIONS JOIN VARIABLES A ON EXPRESSIONS.LEFT_OPERAND = A.NAME JOIN VARIABLES B ON EXPRESSIONS.RIGHT_OPERAND = B.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 389, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, CASE WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE,'TRUE','FALSE') WHEN OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE,'TRUE','FALSE') ELSE IF(V1.VALUE < V2.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 390, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN E.OPERATOR = '=' THEN IF(LEFT_V.VALUE = RIGHT_V.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '<' THEN IF(LEFT_V.VALUE < RIGHT_V.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '>' THEN IF(LEFT_V.VALUE > RIGHT_V.VALUE, 'TRUE', 'FALSE') END VALUE FROM EXPRESSIONS E JOIN VARIABLES LEFT_V ON E.LEFT_OPERAND = LEFT_V.NAME JOIN VARIABLES RIGHT_V ON E.RIGHT_OPERAND = RIGHT_V.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 392, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH TEMP AS ( SELECT LEFT_OPERAND, COALESCE(L.VALUE,0) AS LEFT_VAL, OPERATOR, RIGHT_OPERAND, COALESCE(R.VALUE,0) AS RIGHT_VAL FROM EXPRESSIONS E LEFT JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME LEFT JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME ) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN (CASE WHEN LEFT_VAL > RIGHT_VAL THEN TRUE ELSE FALSE END) WHEN OPERATOR = '<' THEN (CASE WHEN LEFT_VAL < RIGHT_VAL THEN TRUE ELSE FALSE END) WHEN OPERATOR = '=' THEN (CASE WHEN LEFT_VAL = RIGHT_VAL THEN TRUE ELSE FALSE END) END AS VALUE FROM TEMP"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 393, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH T1 AS( SELECT E.*, V1.VALUE L, V2.VALUE R FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND=V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND=V2.NAME ), T2 AS( SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR='>' THEN L>R WHEN OPERATOR='=' THEN L=R WHEN OPERATOR='<' THEN L<R END) VALUE FROM T1 ) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN VALUE=0 THEN FALSE ELSE TRUE END) VALUE FROM T2"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 396, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR = '>' THEN IF(VAR1.VALUE > VAR2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(VAR1.VALUE = VAR2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(VAR1.VALUE < VAR2.VALUE, 'TRUE', 'FALSE') END) AS VALUE FROM EXPRESSIONS EXP JOIN VARIABLES VAR1 ON EXP.LEFT_OPERAND = VAR1.NAME JOIN VARIABLES VAR2 ON EXP.RIGHT_OPERAND = VAR2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 397, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, IF(CASE WHEN E.OPERATOR = '=' THEN V.VALUE = V2.VALUE WHEN E.OPERATOR = '<' THEN V.VALUE < V2.VALUE WHEN E.OPERATOR = '>' THEN V.VALUE > V2.VALUE END, 'TRUE', 'FALSE') AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V ON E.LEFT_OPERAND = V.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 398, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR='>' THEN IF(V1.VALUE > V2.VALUE,'TRUE','FALSE') WHEN OPERATOR='<' THEN IF(V1.VALUE < V2.VALUE,'TRUE','FALSE') WHEN OPERATOR='=' THEN IF(V1.VALUE = V2.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS JOIN VARIABLES V1 ON LEFT_OPERAND=V1.NAME JOIN VARIABLES V2 ON RIGHT_OPERAND=V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 401, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '<' THEN IF(VL.VALUE < VR.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(VL.VALUE > VR.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(VL.VALUE = VR.VALUE, 'TRUE', 'FALSE') END VALUE FROM EXPRESSIONS E JOIN VARIABLES VL ON E.LEFT_OPERAND = VL.NAME JOIN VARIABLES VR ON E.RIGHT_OPERAND = VR.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 402, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR='>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR='<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') WHEN V1.VALUE=V2.VALUE THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') ELSE FALSE END) AS VALUE FROM VARIABLES V1 INNER JOIN EXPRESSIONS E ON V1.NAME=E.LEFT_OPERAND INNER JOIN VARIABLES V2 ON E.RIGHT_OPERAND=V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 405, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, IF(OPERATOR=IF(L.VALUE <R.VALUE,'<',IF(L.VALUE>R.VALUE,'>','=')),'TRUE','FALSE') AS VALUE FROM EXPRESSIONS E JOIN VARIABLES L ON E.LEFT_OPERAND=L.NAME JOIN VARIABLES R ON E.RIGHT_OPERAND=R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 406, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, (CASE WHEN E.OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE,'TRUE', 'FALSE') WHEN E.OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE,'TRUE', 'FALSE') WHEN E.OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE,'TRUE', 'FALSE') END) AS VALUE FROM EXPRESSIONS E LEFT OUTER JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT OUTER JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 410, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT T2.LEFT_OPERAND, T2.OPERATOR, T2.RIGHT_OPERAND, ( CASE WHEN T2.OPERATOR = '>' THEN IF(T2.LEFT_VALUE > T2.RIGHT_VALUE, 'TRUE', 'FALSE') WHEN T2.OPERATOR = '<' THEN IF(T2.LEFT_VALUE < T2.RIGHT_VALUE, 'TRUE', 'FALSE') WHEN T2.OPERATOR = '=' THEN IF(T2.LEFT_VALUE = T2.RIGHT_VALUE, 'TRUE', 'FALSE') ELSE FALSE END ) AS VALUE FROM ( SELECT T1.LEFT_OPERAND, T1.OPERATOR, T1.RIGHT_OPERAND, T3.VALUE AS LEFT_VALUE, T4.VALUE AS RIGHT_VALUE FROM EXPRESSIONS T1 LEFT JOIN VARIABLES T3 ON T1.LEFT_OPERAND = T3.NAME LEFT JOIN VARIABLES T4 ON T1.RIGHT_OPERAND = T4.NAME ) T2"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 411, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, IF(CASE OPERATOR WHEN '<' THEN V1.VALUE < V2.VALUE WHEN '>' THEN V1.VALUE > V2.VALUE ELSE V1.VALUE = V2.VALUE END, 'TRUE', 'FALSE') VALUE FROM EXPRESSIONS E, VARIABLES V1, VARIABLES V2 WHERE E.LEFT_OPERAND = V1.NAME AND E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 412, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH CTE AS( SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, V1.VALUE AS LEFT_VALUE, V2.VALUE AS RIGHT_VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME ) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' AND LEFT_VALUE > RIGHT_VALUE THEN TRUE WHEN OPERATOR = '<' AND LEFT_VALUE < RIGHT_VALUE THEN TRUE WHEN OPERATOR = '= ' AND LEFT_VALUE = RIGHT_VALUE THEN TRUE ELSE FALSE END AS VALUE FROM CTE"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 414, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(A.VALUE > B.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(A.VALUE < B.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(A.VALUE = B.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E INNER JOIN VARIABLES AS A ON A.NAME = E.LEFT_OPERAND INNER JOIN VARIABLES AS B ON B.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 420, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH ASSIGN_VALUES AS ( SELECT A.LEFT_OPERAND,OPERATOR,RIGHT_OPERAND,B.VALUE AS LEFT_VALUE, C.VALUE AS RIGHT_VALUE FROM EXPRESSIONS A JOIN VARIABLES B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES C ON A.RIGHT_OPERAND = C.NAME) SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(LEFT_VALUE > RIGHT_VALUE,'TRUE','FALSE') WHEN OPERATOR = '<' THEN IF(LEFT_VALUE < RIGHT_VALUE,'TRUE','FALSE') WHEN OPERATOR = '=' THEN IF(LEFT_VALUE = RIGHT_VALUE,'TRUE','FALSE') END AS VALUE FROM ASSIGN_VALUES"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 423, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH C1 AS (SELECT LEFT_OPERAND, VALUE AS LEFT_VALUE, OPERATOR, RIGHT_OPERAND FROM EXPRESSIONS E JOIN VARIABLES V ON E.LEFT_OPERAND=V.NAME), C2 AS (SELECT C1.LEFT_OPERAND, C1.LEFT_VALUE, C1.OPERATOR, C1.RIGHT_OPERAND, V.VALUE AS RIGHT_VALUE FROM C1 JOIN VARIABLES V ON C1.RIGHT_OPERAND = V.NAME) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '=' THEN IF(LEFT_VALUE = RIGHT_VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(LEFT_VALUE > RIGHT_VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(LEFT_VALUE < RIGHT_VALUE, 'TRUE', 'FALSE') END AS VALUE FROM C2"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 427, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') ELSE FALSE END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON V2.NAME =E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 428, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '<' THEN IF(V1.VALUE<V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(V1.VALUE<V2.VALUE, 'TRUE', 'FALSE') ELSE IF(V1.VALUE=V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON V1.NAME = E.LEFT_OPERAND JOIN VARIABLES V2 ON V2.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 429, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH C1 AS ( SELECT E.* ,V1.VALUE AS X, V2.VALUE AS Y FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME ), C2 AS ( SELECT *, CASE WHEN X > Y THEN '>' WHEN X < Y THEN '<' ELSE '=' END AS RELATION FROM C1 ) SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND, CASE WHEN RELATION = OPERATOR THEN TRUE ELSE FALSE END AS VALUE FROM C2"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 430, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, CASE WHEN E.OPERATOR='<' THEN IF(L.VALUE<R.VALUE,'TRUE','FALSE') WHEN E.OPERATOR='>' THEN IF(L.VALUE>R.VALUE,'TRUE','FALSE') ELSE IF(L.VALUE=R.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES L ON E.LEFT_OPERAND=L.NAME JOIN VARIABLES R ON E.RIGHT_OPERAND=R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 431, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, (CASE WHEN E.OPERATOR='>' AND V.VALUE>V1.VALUE THEN TRUE WHEN E.OPERATOR='>' AND V.VALUE<=V1.VALUE THEN FALSE WHEN E.OPERATOR='<' AND V.VALUE<V1.VALUE THEN TRUE WHEN E.OPERATOR='<' AND V.VALUE>=V1.VALUE THEN FALSE WHEN E.OPERATOR='=' AND V.VALUE=V1.VALUE THEN TRUE WHEN E.OPERATOR='=' AND V.VALUE<>V1.VALUE THEN FALSE END) AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V ON E.LEFT_OPERAND = V.NAME LEFT JOIN VARIABLES V1 ON E.RIGHT_OPERAND = V1.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 433, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR,E.RIGHT_OPERAND,(CASE WHEN E.OPERATOR='>' THEN IF(V1.VALUE>V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR='<' THEN IF (V1.VALUE<V2.VALUE, 'TRUE','FALSE') ELSE IF(V1.VALUE=V2.VALUE,'TRUE', 'FALSE') END) AS VALUE FROM EXPRESSIONS AS E JOIN VARIABLES AS V1 ON E.LEFT_OPERAND=V1.NAME JOIN VARIABLES AS V2 ON E.RIGHT_OPERAND=V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 435, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, (CASE WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') END) AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON V1.NAME = E.LEFT_OPERAND LEFT JOIN VARIABLES V2 ON V2.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 437, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR = '>' THEN IF (V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF (V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') ELSE IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') END) AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 440, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND,RIGHT_OPERAND,OPERATOR, CASE WHEN LEFT_VALUE>RIGHT_VALUE AND OPERATOR='>' THEN TRUE WHEN LEFT_VALUE=RIGHT_VALUE AND OPERATOR='=' THEN TRUE WHEN LEFT_VALUE<RIGHT_VALUE AND OPERATOR='<' THEN TRUE ELSE FALSE END VALUE FROM (SELECT LEFT_OPERAND,RIGHT_OPERAND, L.VALUE AS LEFT_VALUE,OPERATOR, R.VALUE AS RIGHT_VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES L ON E.LEFT_OPERAND=L.NAME LEFT JOIN VARIABLES R ON E.RIGHT_OPERAND=R.NAME) A"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 447, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN E.OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') ELSE IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
