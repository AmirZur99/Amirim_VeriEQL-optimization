{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 449, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN E.OPERATOR = '=' THEN IF(V.VALUE = VR.VALUE ,'TRUE','FALSE') WHEN E.OPERATOR = '>' THEN IF(V.VALUE > VR.VALUE ,'TRUE','FALSE') WHEN E.OPERATOR = '<' THEN IF(V.VALUE < VR.VALUE ,'TRUE','FALSE') END VALUE FROM EXPRESSIONS E JOIN VARIABLES V ON V.NAME = E.LEFT_OPERAND JOIN VARIABLES VR ON VR.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 455, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF((V1.VALUE-V2.VALUE)>0,'TRUE','FALSE') WHEN OPERATOR = '<' THEN IF ((V1.VALUE-V2.VALUE)<0,'TRUE','FALSE') WHEN OPERATOR = '=' THEN IF ((V1.VALUE-V2.VALUE) = 0, 'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS LEFT JOIN VARIABLES V1 ON EXPRESSIONS.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON EXPRESSIONS.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 456, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, (CASE WHEN E.OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') ELSE IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') END ) AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 457, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, IF(CASE WHEN OPERATOR = '<' THEN LEFTOPVAL.VALUE < RIGHTOPVAL.VALUE WHEN OPERATOR = '>' THEN LEFTOPVAL.VALUE > RIGHTOPVAL.VALUE WHEN OPERATOR = '=' THEN LEFTOPVAL.VALUE = RIGHTOPVAL.VALUE END, 'TRUE','FALSE') AS VALUE FROM EXPRESSIONS JOIN VARIABLES LEFTOPVAL ON LEFT_OPERAND = LEFTOPVAL.NAME JOIN VARIABLES RIGHTOPVAL ON RIGHT_OPERAND = RIGHTOPVAL.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 461, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH CTE AS ( SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND, CASE WHEN T2.VALUE -T3.VALUE > 0 THEN '>' WHEN T2.VALUE -T3.VALUE < 0 THEN '<' ELSE '=' END AS VALUE FROM EXPRESSIONS T1 LEFT JOIN VARIABLES T2 ON T2.NAME = T1.LEFT_OPERAND LEFT JOIN VARIABLES T3 ON T3.NAME = T1.RIGHT_OPERAND) SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND, IF(VALUE = OPERATOR,'TRUE','FALSE') AS VALUE FROM CTE"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 468, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, CASE WHEN E.OPERATOR = '<' THEN IF(L.VALUE < R.VALUE,'TRUE','FALSE') WHEN E.OPERATOR = '>' THEN IF(L.VALUE > R.VALUE,'TRUE','FALSE') ELSE IF(L.VALUE = R.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME LEFT JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 481, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH CTE AS (SELECT B.LEFT_OPERAND, B.OPERATOR, B.RIGHT_OPERAND, A1.VALUE AS LEFT_VALUE, A2.VALUE AS RIGHT_VALUE FROM EXPRESSIONS B INNER JOIN VARIABLES A1 ON B.LEFT_OPERAND = A1.NAME INNER JOIN VARIABLES A2 ON B.RIGHT_OPERAND = A2.NAME) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(LEFT_VALUE>RIGHT_VALUE,'TRUE','FALSE') WHEN OPERATOR = '=' THEN IF(LEFT_VALUE=RIGHT_VALUE,'TRUE','FALSE') WHEN OPERATOR = '<' THEN IF(LEFT_VALUE<RIGHT_VALUE,'TRUE','FALSE') END AS VALUE FROM CTE"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 487, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN E.OPERATOR ='=' THEN IF(V1.VALUE = V2.VALUE,'TRUE', 'FALSE') WHEN E.OPERATOR ='>' THEN IF(V1.VALUE >V2.VALUE,'TRUE','FALSE') WHEN E.OPERATOR ='<' THEN IF(V1.VALUE<V2.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 488, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR = '<' THEN IF(L.VALUE < R.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(L.VALUE > R.VALUE, 'TRUE', 'FALSE') ELSE IF(L.VALUE = R.VALUE, 'TRUE', 'FALSE') END) AS VALUE FROM EXPRESSIONS LEFT JOIN VARIABLES L ON LEFT_OPERAND = L.NAME LEFT JOIN VARIABLES R ON RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 493, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR='>' THEN IF(V1.VALUE>V2.VALUE,'TRUE','FALSE') WHEN OPERATOR='<' THEN IF(V1.VALUE<V2.VALUE,'TRUE','FALSE') WHEN OPERATOR='=' THEN IF(V1.VALUE=V2.VALUE,'TRUE','FALSE') END VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON V1.NAME=E.LEFT_OPERAND JOIN VARIABLES V2 ON V2.NAME=E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 496, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE OPERATOR WHEN '>' THEN IF(LEFTVARIABLES.VALUE > RIGHTVARIABLES.VALUE, 'TRUE', 'FALSE') WHEN '<' THEN IF(LEFTVARIABLES.VALUE < RIGHTVARIABLES.VALUE, 'TRUE', 'FALSE') ELSE IF(LEFTVARIABLES.VALUE = RIGHTVARIABLES.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS JOIN VARIABLES AS LEFTVARIABLES ON LEFT_OPERAND = LEFTVARIABLES.NAME JOIN VARIABLES AS RIGHTVARIABLES ON RIGHT_OPERAND = RIGHTVARIABLES.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 497, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT EXPRESSIONS.*, CASE EXPRESSIONS.OPERATOR WHEN '>' THEN (IF(LEFT_VARIABLES.VALUE > RIGHT_VARIABLES.VALUE, 'TRUE', 'FALSE')) WHEN '<' THEN (IF(LEFT_VARIABLES.VALUE < RIGHT_VARIABLES.VALUE, 'TRUE', 'FALSE')) WHEN '=' THEN(IF(LEFT_VARIABLES.VALUE = RIGHT_VARIABLES.VALUE, 'TRUE', 'FALSE')) END AS VALUE FROM EXPRESSIONS JOIN VARIABLES LEFT_VARIABLES ON LEFT_VARIABLES.NAME = EXPRESSIONS.LEFT_OPERAND JOIN VARIABLES RIGHT_VARIABLES ON RIGHT_VARIABLES.NAME = EXPRESSIONS.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 501, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '=' THEN IF(V.VALUE = V2.VALUE, 'TRUE','FALSE') WHEN OPERATOR = '>' THEN IF(V.VALUE > V2.VALUE, 'TRUE','FALSE') WHEN OPERATOR = '<' THEN IF(V.VALUE < V2.VALUE, 'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V ON E.LEFT_OPERAND = V.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 507, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND,E.OPERATOR,E.RIGHT_OPERAND, CASE WHEN OPERATOR='<' THEN IF (L_V.VALUE <R_V.VALUE,'TRUE','FALSE') WHEN OPERATOR='>' THEN IF (L_V.VALUE >R_V.VALUE,'TRUE','FALSE') WHEN OPERATOR='=' THEN IF (L_V.VALUE =R_V.VALUE,'TRUE','FALSE') END VALUE FROM EXPRESSIONS E JOIN VARIABLES L_V ON (E.LEFT_OPERAND=L_V.NAME) JOIN VARIABLES R_V ON (E.RIGHT_OPERAND=R_V.NAME)"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 508, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND ,OPERATOR ,RIGHT_OPERAND ,CASE WHEN OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE,'TRUE','FALSE') WHEN OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE,'TRUE','FALSE') ELSE IF(V1.VALUE > V2.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 516, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT T.LEFT_OPERAND, T.OPERATOR, T.RIGHT_OPERAND, CASE WHEN T.OPERATOR = '=' THEN IF(T.LEFT_VALUE = T.RIGHT_VALUE, 'TRUE', 'FALSE') WHEN T.OPERATOR = '>' THEN IF(T.LEFT_VALUE > T.RIGHT_VALUE, 'TRUE', 'FALSE') WHEN T.OPERATOR = '<' THEN IF(T.LEFT_VALUE < T.RIGHT_VALUE, 'TRUE', 'FALSE') END AS VALUE FROM ( SELECT E.*, V.VALUE AS LEFT_VALUE, V2.VALUE AS RIGHT_VALUE FROM EXPRESSIONS AS E JOIN VARIABLES AS V ON E.LEFT_OPERAND = V.NAME JOIN VARIABLES AS V2 ON E.RIGHT_OPERAND = V2.NAME ) AS T"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 517, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, IF( IF( E.OPERATOR = '=', L.VALUE = R.VALUE, IF( E.OPERATOR = '>', L.VALUE > R.VALUE, L.VALUE < R.VALUE ) ), 'TRUE', 'FALSE' ) AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES L ON (E.LEFT_OPERAND = L.NAME) LEFT JOIN VARIABLES R ON (E.RIGHT_OPERAND = R.NAME)"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 520, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH T AS ( SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, V.VALUE AS LEFT_VALUE, VV.VALUE AS RIGHT_VALUE, V.VALUE-VV.VALUE AS DIFF FROM EXPRESSIONS E LEFT JOIN VARIABLES V ON E.LEFT_OPERAND=V.NAME LEFT JOIN VARIABLES VV ON E.RIGHT_OPERAND=VV.NAME ) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, IF(CASE OPERATOR WHEN '<' THEN (DIFF<0) WHEN '>' THEN (DIFF>0) WHEN '=' THEN (DIFF=0) END, 'TRUE', 'FALSE') AS VALUE FROM T"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 540, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, CASE WHEN OPERATOR = '>' AND V1.VALUE > V2.VALUE THEN TRUE WHEN OPERATOR = '>' AND V1.VALUE <= V2.VALUE THEN FALSE WHEN OPERATOR = '<' AND V1.VALUE < V2.VALUE THEN TRUE WHEN OPERATOR = '<' AND V1.VALUE >= V2.VALUE THEN FALSE WHEN OPERATOR = '=' AND V1.VALUE = V2.VALUE THEN TRUE WHEN OPERATOR = '=' AND V1.VALUE != V2.VALUE THEN FALSE END AS VALUE FROM EXPRESSIONS AS E JOIN VARIABLES AS V1 ON E.LEFT_OPERAND = V1.NAME JOIN VARIABLES AS V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 542, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR = '>' THEN IF(T.L_VALUE > T.R_VALUE, 'TRUE','FALSE') WHEN OPERATOR = '<' THEN IF (T.L_VALUE < T.R_VALUE, 'TRUE','FALSE') WHEN OPERATOR = '=' THEN IF (T.L_VALUE = T.R_VALUE, 'TRUE','FALSE') END) AS VALUE FROM (SELECT LEFT_OPERAND, V1.VALUE AS L_VALUE, OPERATOR, RIGHT_OPERAND, V2.VALUE AS R_VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON V1.NAME = E.LEFT_OPERAND LEFT JOIN VARIABLES V2 ON V2.NAME = E.RIGHT_OPERAND)T"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 547, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, IF( CASE WHEN OPERATOR = '=' THEN L.VALUE = R.VALUE WHEN OPERATOR = '>' THEN L.VALUE > R.VALUE ELSE L.VALUE < R.VALUE END, 'TRUE', 'FALSE') AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME LEFT JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 548, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND, CASE WHEN OPERATOR='>' THEN IF(LEFT_VALUE>RIGHT_VALUE,'TRUE','FALSE') WHEN OPERATOR='=' THEN IF(LEFT_VALUE=RIGHT_VALUE,'TRUE','FALSE') WHEN OPERATOR='<' THEN IF(LEFT_VALUE<RIGHT_VALUE,'TRUE','FALSE') END AS VALUE FROM (SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND,V1.VALUE AS LEFT_VALUE,V2.VALUE AS RIGHT_VALUE FROM EXPRESSIONS JOIN VARIABLES V1 ON EXPRESSIONS.LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON EXPRESSIONS.RIGHT_OPERAND = V2.NAME) AS TMP"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 556, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') ELSE IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS JOIN VARIABLES V1 ON V1.NAME = LEFT_OPERAND JOIN VARIABLES V2 ON V2.NAME = RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 557, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN E.OPERATOR = '=' THEN IF(V.VALUE = V1.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '>' THEN IF(V.VALUE > V1.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '<' THEN IF(V.VALUE < V1.VALUE, 'TRUE', 'FALSE') END VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V ON V.NAME = E.LEFT_OPERAND LEFT JOIN VARIABLES V1 ON V1.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 558, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(L.VALUE > R.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(L.VALUE < R.VALUE, 'TRUE', 'FALSE') ELSE IF(L.VALUE = R.VALUE, 'TRUE', 'FALSE') END VALUE FROM EXPRESSIONS INNER JOIN VARIABLES L ON LEFT_OPERAND = L.NAME INNER JOIN VARIABLES R ON RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 559, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS JOIN VARIABLES V1 ON LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 560, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT G.LEFT_OPERAND, G.OPERATOR, G.RIGHT_OPERAND, CASE WHEN G.OPERATOR = '=' THEN IF(G.LEFT_VALUE = G.RIGHT_VALUE, 'TRUE', 'FALSE') WHEN G.OPERATOR = '>' THEN IF(G.LEFT_VALUE > G.RIGHT_VALUE, 'TRUE', 'FALSE') WHEN G.OPERATOR = '<' THEN IF(G.LEFT_VALUE < G.RIGHT_VALUE, 'TRUE', 'FALSE') END AS VALUE FROM ( SELECT E.*, V.VALUE AS LEFT_VALUE, V2.VALUE AS RIGHT_VALUE FROM EXPRESSIONS AS E JOIN VARIABLES AS V ON E.LEFT_OPERAND = V.NAME JOIN VARIABLES AS V2 ON E.RIGHT_OPERAND = V2.NAME ) AS G"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 566, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT EXP.*, CASE WHEN OPERATOR = '>' THEN IF(VAR1.VALUE > VAR2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(VAR2.VALUE > VAR1.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(VAR2.VALUE = VAR1.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS AS EXP INNER JOIN VARIABLES AS VAR1 ON VAR1.NAME = EXP.LEFT_OPERAND INNER JOIN VARIABLES AS VAR2 ON VAR2.NAME = EXP.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 568, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR='>' THEN IF(VL.VALUE>VR.VALUE, 'TRUE','FALSE') WHEN OPERATOR='<' THEN IF(VL.VALUE<VR.VALUE, 'TRUE','FALSE') WHEN OPERATOR='=' THEN IF(VL.VALUE=VR.VALUE, 'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES VL ON E.LEFT_OPERAND=VL.NAME JOIN VARIABLES VR ON E.RIGHT_OPERAND=VR.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 570, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH TB AS ( SELECT E.*, V.VALUE AS LEFT_V, V1.VALUE AS RIGHT_V FROM EXPRESSIONS E LEFT JOIN VARIABLES V ON E.LEFT_OPERAND = V.NAME LEFT JOIN VARIABLES V1 ON E.RIGHT_OPERAND = V1.NAME) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR = '>' THEN IF(LEFT_V>RIGHT_V, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(LEFT_V = RIGHT_V, 'TRUE','FALSE') ELSE IF(LEFT_V < RIGHT_V, 'TRUE', 'FALSE') END) AS VALUE FROM TB"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 571, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN E.OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE,'TRUE','FALSE') WHEN E.OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE,'TRUE','FALSE') WHEN E.OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE,'TRUE','FALSE') END VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 572, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN E.OPERATOR='>' THEN IF(VL.VALUE>VR.VALUE,'TRUE','FALSE') WHEN E.OPERATOR='<' THEN IF(VL.VALUE<VR.VALUE,'TRUE','FALSE') ELSE IF(VL.VALUE=VR.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES VL JOIN VARIABLES VR ON E.LEFT_OPERAND=VL.NAME AND E.RIGHT_OPERAND=VR.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 573, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR = '=' THEN IF(VL.VALUE = VR.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(VL.VALUE > VR.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(VL.VALUE < VR.VALUE, 'TRUE', 'FALSE') END) AS VALUE FROM EXPRESSIONS LEFT JOIN VARIABLES VL ON VL.NAME = LEFT_OPERAND LEFT JOIN VARIABLES VR ON VR.NAME = RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 576, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH STEP1 AS ( SELECT LEFT_OPERAND, E.OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN VAR1.VALUE > VAR2.VALUE WHEN OPERATOR = '<' THEN VAR1.VALUE > VAR2.VALUE WHEN OPERATOR = '=' THEN VAR1.VALUE = VAR2.VALUE END AS CASE_ FROM EXPRESSIONS E LEFT JOIN VARIABLES VAR1 ON E.LEFT_OPERAND = VAR1.NAME LEFT JOIN VARIABLES VAR2 ON E.RIGHT_OPERAND=VAR2.NAME ) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN CASE_ = 0 THEN FALSE ELSE TRUE END AS VALUE FROM STEP1"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 580, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT V.LEFT_OPERAND, V.OPERATOR, V.RIGHT_OPERAND, CASE WHEN V.OPERATOR = '>' THEN IF(V.LVALUE>V.RVALUE, 'TRUE', 'FALSE') WHEN V.OPERATOR = '<' THEN IF(V.LVALUE<V.RVALUE, 'TRUE', 'FALSE') ELSE IF(V.LVALUE=V.RVALUE, 'TRUE', 'FALSE') END AS VALUE FROM (SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, V1.VALUE AS LVALUE , V2.VALUE AS RVALUE FROM EXPRESSIONS AS E LEFT JOIN VARIABLES AS V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES AS V2 ON E.RIGHT_OPERAND = V2.NAME) AS V"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 583, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(L.VALUE > R.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(L.VALUE < R.VALUE, 'TRUE', 'FALSE') ELSE IF(L.VALUE = R.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME LEFT JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 585, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, CASE (CASE OPERATOR WHEN '>' THEN L.VALUE>R.VALUE WHEN '<' THEN L.VALUE<R.VALUE ELSE L.VALUE=R.VALUE END) WHEN 0 THEN FALSE ELSE TRUE END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES L ON E.LEFT_OPERAND=L.NAME JOIN VARIABLES R ON E.RIGHT_OPERAND=R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 587, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND , OPERATOR , RIGHT_OPERAND, CASE WHEN OPERATOR ='>' AND L.VALUE > R.VALUE THEN TRUE WHEN OPERATOR ='>' AND L.VALUE <= R.VALUE THEN FALSE WHEN OPERATOR ='<' AND L.VALUE >= R.VALUE THEN FALSE WHEN OPERATOR ='<' AND L.VALUE < R.VALUE THEN TRUE WHEN OPERATOR ='=' AND L.VALUE=R.VALUE THEN TRUE WHEN OPERATOR ='=' AND L.VALUE!=R.VALUE THEN FALSE END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME LEFT JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 590, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE','FALSE') WHEN OPERATOR = '<' THEN IF (V1.VALUE < V2.VALUE, 'TRUE','FALSE') WHEN OPERATOR = '=' THEN IF (V1.VALUE = V2.VALUE, 'TRUE','FALSE') END) AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON V1.NAME = E.LEFT_OPERAND LEFT JOIN VARIABLES V2 ON V2.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 597, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, (CASE WHEN E.OPERATOR = '<' THEN IF(L.VALUE < R.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '>' THEN IF(L.VALUE > R.VALUE, 'TRUE', 'FALSE') ELSE IF(L.VALUE = R.VALUE, 'TRUE', 'FALSE') END) AS VALUE FROM EXPRESSIONS E JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 598, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT A.LEFT_OPERAND, A.OPERATOR, A.RIGHT_OPERAND, CASE A.OPERATOR WHEN '=' THEN IF(B.VALUE = C.VALUE, 'TRUE', 'FALSE') WHEN '>' THEN IF(B.VALUE > C.VALUE, 'TRUE', 'FALSE') WHEN '<' THEN IF(B.VALUE < C.VALUE, 'TRUE', 'FALSE') ELSE NULL END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 600, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '<' THEN IF(VAR1.VALUE < VAR2.VALUE, 'TRUE','FALSE') WHEN OPERATOR = '>' THEN IF(VAR1.VALUE > VAR2.VALUE,'TRUE','FALSE') ELSE IF(VAR1.VALUE = VAR2.VALUE, 'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS EXP JOIN VARIABLES VAR1 ON EXP.LEFT_OPERAND = VAR1.NAME JOIN VARIABLES VAR2 ON EXP.RIGHT_OPERAND = VAR2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 603, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, IF((CASE WHEN OPERATOR ='>' THEN V1.VALUE>V2.VALUE WHEN OPERATOR='=' THEN V1.VALUE=V2.VALUE ELSE V1.VALUE<V2.VALUE END)=0,'FALSE','TRUE') AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON V1.NAME = E.LEFT_OPERAND LEFT JOIN VARIABLES V2 ON V2.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 614, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, IF(CASE E.OPERATOR WHEN '=' THEN L.VALUE = R.VALUE WHEN '>' THEN L.VALUE > R.VALUE WHEN '<' THEN L.VALUE < R.VALUE END = 1, 'TRUE', 'FALSE') AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME LEFT JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 615, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, CASE WHEN E.OPERATOR = '>' AND V.VALUE > V2.VALUE THEN TRUE WHEN E.OPERATOR = '>' AND V.VALUE <= V2.VALUE THEN FALSE WHEN E.OPERATOR = '<' AND V.VALUE < V2.VALUE THEN TRUE WHEN E.OPERATOR = '<' AND V.VALUE >= V2.VALUE THEN FALSE WHEN E.OPERATOR = '=' AND V.VALUE = V2.VALUE THEN TRUE WHEN E.OPERATOR = '=' AND V.VALUE <> V2.VALUE THEN FALSE ELSE '' END AS VALUE FROM EXPRESSIONS AS E LEFT JOIN VARIABLES V ON E.LEFT_OPERAND = V.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 628, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR='>' THEN IF(A.VALUE>B.VALUE, 'TRUE','FALSE') WHEN OPERATOR='<' THEN IF(A.VALUE<B.VALUE, 'TRUE','FALSE') ELSE IF(A.VALUE=B.VALUE, 'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES A ON A.NAME=LEFT_OPERAND JOIN VARIABLES B ON B.NAME=RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 630, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH T1 AS( SELECT CASE WHEN LEFT_OPERAND = V1.NAME THEN V1.VALUE END LEFT_VALUE, CASE WHEN RIGHT_OPERAND = V2.NAME THEN V2.VALUE END RIGHT_VALUE, E.* FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME) SELECT LEFT_OPERAND, OPERATOR,RIGHT_OPERAND , CASE WHEN OPERATOR = '>' THEN IF(LEFT_VALUE>RIGHT_VALUE,'TRUE','FALSE') WHEN OPERATOR = '<' THEN IF(LEFT_VALUE<RIGHT_VALUE,'TRUE','FALSE') WHEN OPERATOR = '=' THEN IF(LEFT_VALUE = RIGHT_VALUE,'TRUE','FALSE') END VALUE FROM T1"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 634, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF ((B.VALUE) > (C.VALUE), 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF ((B.VALUE) < (C.VALUE), 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF ((B.VALUE) = (C.VALUE), 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 637, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '=' THEN IF(LEFT_VALUE = RIGHT_VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(LEFT_VALUE < RIGHT_VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(LEFT_VALUE > RIGHT_VALUE, 'TRUE', 'FALSE') END AS VALUE FROM (SELECT E.*, V1.VALUE AS LEFT_VALUE, V2.VALUE AS RIGHT_VALUE FROM EXPRESSIONS AS E JOIN VARIABLES AS V1 ON E.LEFT_OPERAND = V1.NAME JOIN VARIABLES AS V2 ON E.RIGHT_OPERAND = V2.NAME) AS T"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 639, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR = '>' THEN IF (V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF (V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF (V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') END) AS VALUE FROM EXPRESSIONS LEFT JOIN VARIABLES V1 ON EXPRESSIONS.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON EXPRESSIONS.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 646, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN E.OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE,'TRUE','FALSE') WHEN E.OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE,'TRUE','FALSE') WHEN E.OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE,'TRUE','FALSE') END VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 648, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN E.OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') ELSE IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 650, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN E.OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') ELSE IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON V1.NAME=E.LEFT_OPERAND JOIN VARIABLES V2 ON V2.NAME=E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 652, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, IF(VAL = 0, 'FALSE', 'TRUE') AS VALUE FROM (WITH TEMP_TABLE AS ( SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, LEFT_VAL, VALUE AS RIGHT_VAL FROM VARIABLES V INNER JOIN ( SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, VALUE AS LEFT_VAL, NAME FROM EXPRESSIONS INNER JOIN VARIABLES ON NAME = LEFT_OPERAND) AS T ON V.NAME = T.RIGHT_OPERAND) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN (LEFT_VAL > RIGHT_VAL) WHEN OPERATOR = '<' THEN (LEFT_VAL < RIGHT_VAL) ELSE (LEFT_VAL = RIGHT_VAL) END AS VAL FROM TEMP_TABLE) AS D"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 653, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '=' AND L.VALUE = R.VALUE THEN TRUE WHEN OPERATOR = '=' AND L.VALUE != R.VALUE THEN FALSE WHEN OPERATOR = '>' AND L.VALUE > R.VALUE THEN TRUE WHEN OPERATOR = '>' AND L.VALUE <= R.VALUE THEN FALSE WHEN OPERATOR = '<' AND L.VALUE < R.VALUE THEN TRUE WHEN OPERATOR = '<' AND L.VALUE >= R.VALUE THEN FALSE END AS VALUE FROM EXPRESSIONS JOIN VARIABLES L ON EXPRESSIONS.LEFT_OPERAND = L.NAME JOIN VARIABLES R ON EXPRESSIONS.RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 654, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH FULL_EXPRESSIONS AS ( SELECT E.LEFT_OPERAND , V1.VALUE AS LEFT_VALUE , E.OPERATOR , V2.VALUE AS RIGHT_VALUE , E.RIGHT_OPERAND FROM EXPRESSIONS E INNER JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME INNER JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME ) SELECT LEFT_OPERAND , OPERATOR , RIGHT_OPERAND , CASE WHEN OPERATOR = '=' THEN IF(LEFT_VALUE = RIGHT_VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(LEFT_VALUE > RIGHT_VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(LEFT_VALUE < RIGHT_VALUE, 'TRUE', 'FALSE') END AS VALUE FROM FULL_EXPRESSIONS"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 655, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN E.OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS AS E LEFT JOIN VARIABLES AS V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES AS V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 668, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH A AS ( SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN V1.VALUE>V2.VALUE THEN '>' WHEN V1.VALUE<V2.VALUE THEN '<' ELSE '=' END AS OPERATOR1 FROM EXPRESSIONS E INNER JOIN VARIABLES V1 ON V1.NAME=LEFT_OPERAND INNER JOIN VARIABLES V2 ON V2.NAME=RIGHT_OPERAND) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, IF(OPERATOR=OPERATOR1, 'TRUE', 'FALSE') AS VALUE FROM A"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 670, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') ELSE IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON V1.NAME = E.LEFT_OPERAND LEFT JOIN VARIABLES V2 ON V2.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 675, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH BASE AS (SELECT A.* , B.VALUE AS V1, C.VALUE AS V2 FROM EXPRESSIONS A LEFT JOIN VARIABLES B ON A.LEFT_OPERAND=B.NAME LEFT JOIN VARIABLES C ON A.RIGHT_OPERAND=C.NAME) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND , CASE WHEN OPERATOR='='THEN IF (V1=V2, 'TRUE','FALSE') WHEN OPERATOR='<' THEN IF (V1<V2, 'TRUE','FALSE') WHEN OPERATOR='>' THEN IF (V1>V2, 'TRUE','FALSE') END AS VALUE FROM BASE"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 677, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE' ) WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE' ) WHEN OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE' ) END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON V1.NAME = E.LEFT_OPERAND LEFT JOIN VARIABLES V2 ON V2.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 679, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '<' THEN IF(L.VALUE < R.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(L.VALUE > R.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(L.VALUE = R.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME LEFT JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 688, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(LEFT_VALUE > RIGHT_VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(LEFT_VALUE = RIGHT_VALUE, 'TRUE', 'FALSE') ELSE IF(LEFT_VALUE < RIGHT_VALUE, 'TRUE', 'FALSE') END AS VALUE FROM( SELECT LEFT_OPERAND, V1.VALUE AS LEFT_VALUE, OPERATOR, RIGHT_OPERAND, V2.VALUE AS RIGHT_VALUE FROM EXPRESSIONS JOIN VARIABLES V1 ON EXPRESSIONS.LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON EXPRESSIONS.RIGHT_OPERAND = V2.NAME )T"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 689, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND,E.OPERATOR,E.RIGHT_OPERAND, CASE WHEN OPERATOR='=' THEN IF(T1.VALUE=T2.VALUE,'TRUE','FALSE') WHEN OPERATOR='>' THEN IF(T1.VALUE>T2.VALUE,'TRUE','FALSE') WHEN OPERATOR='<' THEN IF(T1.VALUE<T2.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES T1 ON T1.NAME=E.LEFT_OPERAND JOIN VARIABLES T2 ON T2.NAME=E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 694, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR = '=' THEN IF(A.VALUE = B.VALUE,'TRUE','FALSE') WHEN OPERATOR = '>' THEN IF(A.VALUE > B.VALUE,'TRUE','FALSE') WHEN OPERATOR = '<' THEN IF(A.VALUE < B.VALUE,'TRUE','FALSE') END) AS VALUE FROM EXPRESSIONS X LEFT JOIN VARIABLES A ON X.LEFT_OPERAND = A.NAME LEFT JOIN VARIABLES B ON X.RIGHT_OPERAND = B.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 699, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH CTE AS ( SELECT E.*, V1.VALUE AS LEFT_VALUE , V2.VALUE AS RIGHT_VALUE FROM EXPRESSIONS E INNER JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME INNER JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME ) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '=' THEN IF(LEFT_VALUE=RIGHT_VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(LEFT_VALUE>RIGHT_VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(LEFT_VALUE<RIGHT_VALUE, 'TRUE', 'FALSE') END AS VALUE FROM CTE ORDER BY 1, 2"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 700, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') ELSE IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E INNER JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME INNER JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 702, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE OPERATOR WHEN '<' THEN IF(LV.VALUE < RV.VALUE, 'TRUE', 'FALSE') WHEN '>' THEN IF(LV.VALUE > RV.VALUE, 'TRUE', 'FALSE') ELSE IF(LV.VALUE = RV.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS JOIN VARIABLES LV ON LEFT_OPERAND = LV.NAME JOIN VARIABLES RV ON RIGHT_OPERAND = RV.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 710, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT A.LEFT_OPERAND, A.OPERATOR, A.RIGHT_OPERAND, CASE WHEN OPERATOR = '=' THEN IF(B.VALUE = C.VALUE, 'TRUE','FALSE') WHEN OPERATOR = '<' THEN IF(B.VALUE < C.VALUE, 'TRUE','FALSE') WHEN OPERATOR = '>' THEN IF (B.VALUE > C.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS A JOIN VARIABLES B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES C ON A.RIGHT_OPERAND = C.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 712, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN E.OPERATOR = '=' THEN IF(V.VALUE = VR.VALUE ,'TRUE','FALSE') WHEN E.OPERATOR = '>' THEN IF(V.VALUE > VR.VALUE ,'TRUE','FALSE') WHEN E.OPERATOR = '<' THEN IF(V.VALUE < VR.VALUE ,'TRUE','FALSE') END VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V ON V.NAME = E.LEFT_OPERAND LEFT JOIN VARIABLES VR ON VR.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 714, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH T AS( SELECT E.*, V1.VALUE - V2.VALUE AS DELTA FROM EXPRESSIONS E JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME ORDER BY RIGHT_OPERAND DESC, OPERATOR ) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN (OPERATOR = '>' AND DELTA > 0) THEN TRUE WHEN (OPERATOR = '>' AND DELTA <= 0) THEN FALSE WHEN (OPERATOR = '<' AND DELTA >= 0) THEN FALSE WHEN (OPERATOR = '<' AND DELTA < 0) THEN TRUE WHEN (OPERATOR = '=' AND DELTA = 0) THEN TRUE WHEN (OPERATOR = '=' AND DELTA <> 0) THEN FALSE ELSE NULL END AS VALUE FROM T"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 716, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND ,E.OPERATOR ,E.RIGHT_OPERAND ,CASE WHEN E.OPERATOR ='<' THEN IF(V.VALUE <V1.VALUE ,'TRUE','FALSE') WHEN E.OPERATOR ='>' THEN IF(V.VALUE >V1.VALUE ,'TRUE','FALSE') WHEN E.OPERATOR ='=' THEN IF(V.VALUE =V1.VALUE ,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS AS E LEFT JOIN VARIABLES AS V ON (V.NAME=E.LEFT_OPERAND) LEFT JOIN VARIABLES AS V1 ON (V1.NAME=E.RIGHT_OPERAND)"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 717, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR='>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR='<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR='=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') END) AS VALUE FROM VARIABLES V1 INNER JOIN EXPRESSIONS E ON V1.NAME=E.LEFT_OPERAND INNER JOIN VARIABLES V2 ON E.RIGHT_OPERAND=V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 719, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR='>' THEN IF(A.VALUE>B.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR='<' THEN IF(A.VALUE<B.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR='=' THEN IF(A.VALUE=B.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS INNER JOIN VARIABLES A ON A.NAME=EXPRESSIONS.LEFT_OPERAND INNER JOIN VARIABLES B ON B.NAME=EXPRESSIONS.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 730, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT V1.NAME AS LEFT_OPERAND, E.OPERATOR, V2.NAME AS RIGHT_OPERAND, CASE WHEN OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE' ) WHEN OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE' ) WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE' ) END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON V1.NAME = E.LEFT_OPERAND LEFT JOIN VARIABLES V2 ON V2.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 125, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT A.ACCOUNT_ID FROM LOGINFO A INNER JOIN LOGINFO B ON A.ACCOUNT_ID=B.ACCOUNT_ID AND A.IP_ADDRESS != B.IP_ADDRESS AND A.LOGIN >B.LOGIN AND A.LOGIN<=B.LOGOUT"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 144, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT A.ACCOUNT_ID FROM LOGINFO A, LOGINFO B WHERE A.LOGIN < B.LOGIN AND A.LOGOUT >= B.LOGIN AND A.ACCOUNT_ID = B.ACCOUNT_ID AND A.IP_ADDRESS != B.IP_ADDRESS"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 187, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT L1.ACCOUNT_ID FROM LOGINFO L1, LOGINFO L2 WHERE L1.ACCOUNT_ID = L2.ACCOUNT_ID AND L1.LOGOUT >= L2.LOGIN AND L1.LOGIN < L2.LOGIN AND L1.IP_ADDRESS <> L2.IP_ADDRESS"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 191, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT L1.ACCOUNT_ID FROM LOGINFO L1 INNER JOIN LOGINFO L2 ON L1.ACCOUNT_ID = L2.ACCOUNT_ID WHERE L1.IP_ADDRESS <> L2.IP_ADDRESS AND (L2.LOGIN > L1.LOGIN AND L2.LOGIN <= L1.LOGOUT)"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 193, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT L1.ACCOUNT_ID FROM LOGINFO L1 INNER JOIN LOGINFO L2 ON L1.ACCOUNT_ID = L2.ACCOUNT_ID AND L1.IP_ADDRESS != L2.IP_ADDRESS WHERE (L1.LOGOUT >= L2.LOGIN AND L1.LOGIN < L2.LOGIN)"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 195, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT L1.ACCOUNT_ID FROM LOGINFO L1 INNER JOIN LOGINFO L2 ON L1.ACCOUNT_ID =L2.ACCOUNT_ID AND L1.IP_ADDRESS !=L2.IP_ADDRESS AND L1.LOGIN > L2.LOGIN AND L1.LOGIN <= L2.LOGOUT"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 212, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT T1.ACCOUNT_ID FROM LOGINFO T1, LOGINFO T2 WHERE T1.ACCOUNT_ID = T2.ACCOUNT_ID AND T1.IP_ADDRESS <> T2.IP_ADDRESS AND T1.LOGIN < T2.LOGIN AND T1.LOGOUT >= T2.LOGIN"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 223, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "WITH CTE AS ( SELECT L1.*,L2.IP_ADDRESS OTHER_IP ,L2.LOGIN AS OTHER_LOGIN ,L2.LOGOUT AS OTHER_LOGOUT FROM LOGINFO L1 INNER JOIN LOGINFO L2 ON L1.ACCOUNT_ID = L2.ACCOUNT_ID AND L1.IP_ADDRESS <> L2.IP_ADDRESS AND DATE(L1.LOGIN) = DATE(L2.LOGIN) ) SELECT DISTINCT ACCOUNT_ID FROM CTE WHERE OTHER_LOGIN BETWEEN LOGIN AND LOGOUT"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 240, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "WITH TMP2 AS ( SELECT T1.ACCOUNT_ID, T1.IP_ADDRESS, T1.LOGOUT, T2.LOGIN, CASE WHEN T1.LOGIN < T2.LOGIN AND T1.LOGOUT < T2.LOGIN THEN 'NOT BANNED ELSE BANNED' END AS LABEL FROM LOGINFO T1 LEFT JOIN LOGINFO T2 ON T1.ACCOUNT_ID = T2.ACCOUNT_ID AND T1.IP_ADDRESS <> T2.IP_ADDRESS AND T1.LOGIN < T2.LOGIN WHERE T2.LOGIN <= T1.LOGOUT ) SELECT DISTINCT ACCOUNT_ID FROM TMP2 WHERE LABEL = 'BANNED'"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 252, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT A.ACCOUNT_ID FROM LOGINFO A JOIN LOGINFO B ON A.ACCOUNT_ID=B.ACCOUNT_ID WHERE A.IP_ADDRESS<>B.IP_ADDRESS AND ((A.LOGIN<B.LOGIN AND A.LOGOUT>=B.LOGIN) OR (B.LOGIN<A.LOGIN AND B.LOGOUT>=A.LOGIN))"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 280, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT L.ACCOUNT_ID FROM LOGINFO L JOIN LOGINFO I ON L.ACCOUNT_ID = I.ACCOUNT_ID AND ((I.LOGIN BETWEEN L.LOGIN AND L.LOGOUT) OR (I.LOGOUT BETWEEN L.LOGIN AND L.LOGOUT)) AND I.LOGIN <> L.LOGIN AND I.LOGOUT <> L.LOGOUT AND I.IP_ADDRESS <> L.IP_ADDRESS"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 314, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT A.ACCOUNT_ID FROM LOGINFO A, LOGINFO B WHERE DATE(A.LOGIN)=DATE(B.LOGIN) AND B.LOGIN BETWEEN A.LOGIN AND A.LOGOUT AND A.ACCOUNT_ID=B.ACCOUNT_ID AND A.IP_ADDRESS<>B.IP_ADDRESS"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 318, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT L1.ACCOUNT_ID FROM LOGINFO L1 INNER JOIN LOGINFO L2 ON L1.ACCOUNT_ID = L2.ACCOUNT_ID WHERE L1.LOGIN <> L2.LOGIN AND ((L1.LOGIN BETWEEN L2.LOGIN AND L2.LOGOUT) OR (L1.LOGOUT) BETWEEN L2.LOGIN AND L2.LOGOUT) AND L1.IP_ADDRESS <> L2.IP_ADDRESS"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 354, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT A.ACCOUNT_ID FROM LOGINFO A LEFT JOIN LOGINFO B ON A.ACCOUNT_ID = B.ACCOUNT_ID WHERE B.LOGIN > A.LOGIN AND B.LOGIN <= A.LOGOUT AND A.IP_ADDRESS <> B.IP_ADDRESS"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 417, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT L1.ACCOUNT_ID FROM LOGINFO L1 LEFT JOIN LOGINFO L2 ON L1.ACCOUNT_ID=L2.ACCOUNT_ID WHERE L1.LOGIN!=L2.LOGIN AND L1.LOGOUT>=L2.LOGIN AND L1.LOGOUT<=L2.LOGOUT AND L1.IP_ADDRESS!=L2.IP_ADDRESS"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 446, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT A.ACCOUNT_ID FROM LOGINFO A JOIN LOGINFO B ON A.ACCOUNT_ID = B.ACCOUNT_ID AND A.IP_ADDRESS != B.IP_ADDRESS AND A.LOGIN < B.LOGIN WHERE (A.LOGOUT- B.LOGIN) >=0"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 451, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "WITH CTE AS (SELECT LOG1.ACCOUNT_ID AS LOG1ID, LOG2.ACCOUNT_ID AS LOG2ID, LOG1.IP_ADDRESS AS LOG1ADD, LOG2.IP_ADDRESS AS LOG2ADD, LOG1.LOGIN AS LOG1LOGIN, LOG2.LOGIN AS LOG2LOGIN, LOG1.LOGOUT AS LOG1LOGOUT,LOG2.LOGOUT AS LOG2LOGOUT FROM LOGINFO LOG1, LOGINFO LOG2 WHERE LOG1.ACCOUNT_ID = LOG2.ACCOUNT_ID AND LOG1.IP_ADDRESS != LOG2.IP_ADDRESS ) SELECT DISTINCT CTE.LOG1ID AS ACCOUNT_ID FROM CTE WHERE CTE.LOG2LOGIN <= CTE.LOG1LOGOUT AND CTE.LOG1LOGIN < CTE.LOG2LOGIN"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["EQU", "NEQ"]}
