{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 238, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(L.VALUE > R.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(L.VALUE = R.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(L.VALUE < R.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME LEFT JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 239, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(LFT.VALUE > RGT.VALUE,'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF (LFT.VALUE < RGT.VALUE,'TRUE' , 'FALSE') WHEN OPERATOR = '=' THEN IF (LFT.VALUE = RGT.VALUE,'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS JOIN VARIABLES LFT ON LEFT_OPERAND = LFT.NAME JOIN VARIABLES RGT ON RIGHT_OPERAND = RGT.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 248, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN V1.VALUE>V2.VALUE AND OPERATOR='>' THEN TRUE WHEN V1.VALUE<=V2.VALUE AND OPERATOR='>' THEN FALSE WHEN V1.VALUE<V2.VALUE AND OPERATOR='<' THEN TRUE WHEN V1.VALUE>=V2.VALUE AND OPERATOR='<' THEN FALSE WHEN V1.VALUE=V2.VALUE AND OPERATOR='=' THEN TRUE WHEN V1.VALUE<>V2.VALUE AND OPERATOR='=' THEN FALSE END AS VALUE FROM EXPRESSIONS JOIN VARIABLES V1 ON LEFT_OPERAND=V1.NAME JOIN VARIABLES V2 ON RIGHT_OPERAND=V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 251, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, IF(OPERATOR=RESULT,'TRUE','FALSE') AS VALUE FROM( SELECT A.*, CASE WHEN B.VALUE > C.VALUE THEN '>' WHEN B.VALUE < C.VALUE THEN '<' ELSE '=' END AS RESULT FROM EXPRESSIONS A INNER JOIN VARIABLES B ON A.LEFT_OPERAND=B.NAME INNER JOIN VARIABLES C ON A.RIGHT_OPERAND=C.NAME) T"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 252, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND,CASE WHEN OPERATOR = '>' THEN IF(LFT.VALUE > RGT.VALUE, 'TRUE','FALSE') WHEN OPERATOR = '<' THEN IF(LFT.VALUE < RGT.VALUE, 'TRUE','FALSE') WHEN OPERATOR = '=' THEN IF(LFT.VALUE = RGT.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES LFT ON LFT.NAME = E.LEFT_OPERAND JOIN VARIABLES RGT ON RGT.NAME = E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 257, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND, IF( CASE WHEN OPERATOR = '>' THEN V.VALUE > V1.VALUE WHEN OPERATOR = '=' THEN V.VALUE = V1.VALUE WHEN OPERATOR = '<' THEN V.VALUE < V1.VALUE END , 'TRUE', 'FALSE' ) AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V ON E.LEFT_OPERAND = V.NAME JOIN VARIABLES V1 ON E.RIGHT_OPERAND = V1.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 258, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND, IF(OPERATOR = '>',IF(VALUE1>VALUE2,'TRUE','FALSE'),IF(OPERATOR = '<',IF(VALUE1<VALUE2,'TRUE','FALSE'),IF(VALUE1=VALUE2,'TRUE','FALSE'))) VALUE FROM (SELECT E.*, V.VALUE VALUE1 , V1.VALUE VALUE2 FROM VARIABLES V JOIN EXPRESSIONS E ON E.LEFT_OPERAND = V.NAME JOIN VARIABLES V1 ON V1.NAME = E.RIGHT_OPERAND) FF"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 264, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH CTE AS ( SELECT EXPRESSIONS.*, VALA.VALUE AS A, VALB.VALUE AS B FROM EXPRESSIONS LEFT JOIN VARIABLES VALA ON LEFT_OPERAND=VALA.NAME LEFT JOIN VARIABLES VALB ON RIGHT_OPERAND =VALB.NAME ) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, IF(OPERATOR='>',IF(A>B,'TRUE','FALSE'),IF(OPERATOR='=',IF(A=B,'TRUE','FALSE'),IF(OPERATOR='<',IF(A<B,'TRUE','FALSE'),'FALSE'))) AS VALUE FROM CTE"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 268, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH CTE AS ( SELECT E.LEFT_OPERAND,E.OPERATOR,E.RIGHT_OPERAND,V.NAME AS LNAME, V.VALUE AS LVALUE FROM VARIABLES V RIGHT OUTER JOIN EXPRESSIONS E ON V.NAME=E.LEFT_OPERAND), TK AS (SELECT * FROM VARIABLES P RIGHT OUTER JOIN CTE C ON P.NAME = C.RIGHT_OPERAND) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(LVALUE > VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(LVALUE < VALUE, 'TRUE', 'FALSE') ELSE IF(LVALUE = VALUE, 'TRUE', 'FALSE') END AS VALUE FROM TK"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 276, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH CTE AS( SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND, L.VALUE AS LV, R.VALUE AS RV FROM EXPRESSIONS E JOIN VARIABLES L ON E.LEFT_OPERAND = L.NAME JOIN VARIABLES R ON E.RIGHT_OPERAND = R.NAME) SELECT LEFT_OPERAND,OPERATOR,RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(LV > RV, 'TRUE','FALSE') WHEN OPERATOR = '<' THEN IF(LV < RV, 'TRUE','FALSE') ELSE IF(LV = RV, 'TRUE','FALSE') END AS VALUE FROM CTE"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 277, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH CTE1 AS ( SELECT LEFT_OPERAND ,OPERATOR,RIGHT_OPERAND, V1.VALUE AS LEFT_VALUE,V2.VALUE AS RIGHT_VALUE FROM EXPRESSIONS LEFT JOIN VARIABLES V1 ON EXPRESSIONS.LEFT_OPERAND =V1.NAME LEFT JOIN VARIABLES V2 ON EXPRESSIONS.RIGHT_OPERAND =V2.NAME ) SELECT LEFT_OPERAND ,OPERATOR,RIGHT_OPERAND, CASE OPERATOR WHEN '>' THEN IF(LEFT_VALUE > RIGHT_VALUE,'TRUE','FALSE') WHEN '<' THEN IF(LEFT_VALUE < RIGHT_VALUE,'TRUE','FALSE') WHEN '=' THEN IF(LEFT_VALUE = RIGHT_VALUE,'TRUE','FALSE') END AS VALUE FROM CTE1"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 278, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH CTE_JOIN AS ( SELECT E.*, IF( CASE WHEN OPERATOR = '>' THEN LEFT_V.VALUE > RIGHT_V.VALUE WHEN OPERATOR = '=' THEN LEFT_V.VALUE = RIGHT_V.VALUE WHEN OPERATOR = '<' THEN LEFT_V.VALUE < RIGHT_V.VALUE END = 1, 'TRUE', 'FALSE' ) AS VALUE FROM EXPRESSIONS AS E JOIN VARIABLES AS LEFT_V ON E.LEFT_OPERAND = LEFT_V.NAME JOIN VARIABLES AS RIGHT_V ON E.RIGHT_OPERAND = RIGHT_V.NAME ) SELECT * FROM CTE_JOIN"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 283, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH T AS ( SELECT VALUE AS LVALUE,OPERATOR,NAME LEFT_OPERAND, RIGHT_OPERAND FROM EXPRESSIONS JOIN VARIABLES ON EXPRESSIONS.LEFT_OPERAND =VARIABLES.NAME ), R AS (SELECT OPERATOR, VALUE AS RVALUE, LEFT_OPERAND, RIGHT_OPERAND FROM EXPRESSIONS JOIN VARIABLES ON EXPRESSIONS.RIGHT_OPERAND =VARIABLES.NAME ), TMP AS (SELECT T.LVALUE, T.LEFT_OPERAND,T.OPERATOR, T.RIGHT_OPERAND, R.RVALUE FROM T JOIN R ON T.LEFT_OPERAND =R.LEFT_OPERAND AND T.RIGHT_OPERAND =R.RIGHT_OPERAND AND T.OPERATOR = R.OPERATOR ) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(LVALUE > RVALUE, 'TRUE', 'FALSE' ) WHEN OPERATOR = '=' THEN IF(LVALUE = RVALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(LVALUE < RVALUE, 'TRUE', 'FALSE' ) END AS VALUE FROM TMP"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 284, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH T AS (SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, LV.NAME AS LV_NAME, LV.VALUE AS LV_VALUE, RV.NAME AS RV_NAME, RV.VALUE AS RV_VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES LV ON E.LEFT_OPERAND= LV.NAME LEFT JOIN VARIABLES RV ON E.RIGHT_OPERAND = RV.NAME) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(LV_VALUE>RV_VALUE=1, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(LV_VALUE=RV_VALUE=1, 'TRUE', 'FALSE') ELSE IF(LV_VALUE<RV_VALUE=1, 'TRUE', 'FALSE') END AS VALUE FROM T"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 285, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH T AS (SELECT E.LEFT_OPERAND,E.OPERATOR,E.RIGHT_OPERAND,V1.VALUE AS LEFT_VALUE,V2.VALUE AS RIGHT_VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON V1.NAME=LEFT_OPERAND LEFT JOIN VARIABLES V2 ON V2.NAME=RIGHT_OPERAND) SELECT LEFT_OPERAND, OPERATOR,RIGHT_OPERAND, CASE WHEN LEFT_VALUE>RIGHT_VALUE AND OPERATOR!='>' THEN FALSE WHEN LEFT_VALUE<RIGHT_VALUE AND OPERATOR!='<' THEN FALSE WHEN LEFT_VALUE>RIGHT_VALUE AND OPERATOR='=' THEN FALSE WHEN LEFT_VALUE<RIGHT_VALUE AND OPERATOR='=' THEN FALSE WHEN LEFT_VALUE=RIGHT_VALUE AND OPERATOR!='=' THEN FALSE WHEN LEFT_VALUE=RIGHT_VALUE AND OPERATOR='=' THEN TRUE ELSE TRUE END AS VALUE FROM T"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 288, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH T1 AS (SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN B.VALUE > C.VALUE THEN '>' WHEN B.VALUE < C.VALUE THEN '<' ELSE '=' END AS RELATIONSHIP FROM EXPRESSIONS A JOIN VARIABLES B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES C ON A.RIGHT_OPERAND = C.NAME) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = RELATIONSHIP THEN TRUE ELSE FALSE END AS VALUE FROM T1"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 290, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH TEMP AS ( SELECT LEFT_OPERAND, E.OPERATOR, RIGHT_OPERAND, CASE E.OPERATOR WHEN '<' THEN (VL.VALUE < VR.VALUE) WHEN '=' THEN (VL.VALUE = VR.VALUE) WHEN '>' THEN (VL.VALUE > VR.VALUE) END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES VL ON E.LEFT_OPERAND = VL.NAME LEFT JOIN VARIABLES VR ON E.RIGHT_OPERAND = VR.NAME ) SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE VALUE WHEN 0 THEN FALSE WHEN 1 THEN TRUE END AS VALUE FROM TEMP"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 291, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH TEMP AS ( SELECT LEFT_OPERAND, E.OPERATOR, RIGHT_OPERAND, CASE E.OPERATOR WHEN '<' THEN IF((VL.VALUE < VR.VALUE), 'TRUE', 'FALSE') WHEN '=' THEN IF((VL.VALUE = VR.VALUE), 'TRUE', 'FALSE') WHEN '>' THEN IF((VL.VALUE > VR.VALUE), 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES VL ON E.LEFT_OPERAND = VL.NAME LEFT JOIN VARIABLES VR ON E.RIGHT_OPERAND = VR.NAME ) SELECT * FROM TEMP"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
