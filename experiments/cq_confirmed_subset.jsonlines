{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 298, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, CASE WHEN OPERATOR='>' THEN IF(V1.VALUE > V2.VALUE,'TRUE','FALSE') WHEN OPERATOR='<' THEN IF(V1.VALUE < V2.VALUE,'TRUE','FALSE') WHEN OPERATOR='=' THEN IF(V1.VALUE = V2.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON E.LEFT_OPERAND=V1.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND=V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 299, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT V1.NAME AS LEFT_OPERAND, OPERATOR, V2.NAME AS RIGHT_OPERAND, CASE WHEN OPERATOR ='>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR ='=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR ='<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 302, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR= '<' THEN CASE WHEN (B.VALUE<C.VALUE) = 0 THEN FALSE ELSE TRUE END WHEN OPERATOR = '>' THEN CASE WHEN (B.VALUE >C.VALUE) = 0 THEN FALSE ELSE TRUE END ELSE CASE WHEN (B.VALUE =C.VALUE) = 0 THEN FALSE ELSE TRUE END END AS VALUE FROM EXPRESSIONS A LEFT JOIN VARIABLES B ON A.LEFT_OPERAND = B.NAME LEFT JOIN VARIABLES C ON A.RIGHT_OPERAND = C.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 304, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 309, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '=' THEN IF(LV = RV, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(LV > RV, 'TRUE', 'FALSE') ELSE IF(LV < RV, 'TRUE', 'FALSE') END AS VALUE FROM (SELECT LV, A.OPERATOR, VALUE AS RV, A.LEFT_OPERAND, RIGHT_OPERAND FROM (SELECT LEFT_OPERAND, VALUE AS LV, OPERATOR, RIGHT_OPERAND FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON LEFT_OPERAND = NAME) A LEFT JOIN VARIABLES V2 ON RIGHT_OPERAND = NAME) NEW"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 310, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR='>' AND V1.VALUE>V2.VALUE THEN TRUE WHEN OPERATOR='>' AND V1.VALUE<=V2.VALUE THEN FALSE WHEN OPERATOR='<' AND V1.VALUE<V2.VALUE THEN TRUE WHEN OPERATOR='<' AND V1.VALUE>=V2.VALUE THEN FALSE WHEN OPERATOR='=' AND V1.VALUE=V2.VALUE THEN TRUE WHEN OPERATOR='=' AND V1.VALUE!=V2.VALUE THEN FALSE END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON E.LEFT_OPERAND=V1.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND=V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 312, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE,'TRUE','FALSE') WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE,'TRUE','FALSE') WHEN OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE,'TRUE','FALSE') ELSE NULL END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON V1.NAME = LEFT_OPERAND LEFT JOIN VARIABLES V2 ON V2.NAME = RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 314, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT A.*, CASE WHEN A.OPERATOR = '>' THEN IF(B.VALUE>C.VALUE,'TRUE','FALSE') WHEN A.OPERATOR = '<' THEN IF(B.VALUE<C.VALUE,'TRUE','FALSE') ELSE IF(B.VALUE=C.VALUE,'TRUE','FALSE') END AS VALUE FROM EXPRESSIONS A, VARIABLES B, VARIABLES C WHERE A.LEFT_OPERAND=B.NAME AND A.RIGHT_OPERAND=C.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 319, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, (CASE WHEN OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') END) AS VALUE FROM EXPRESSIONS LEFT JOIN VARIABLES V1 ON V1.NAME = LEFT_OPERAND LEFT JOIN VARIABLES V2 ON V2.NAME = RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 320, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN (CASE WHEN (V1.VALUE - V2.VALUE) > 0 THEN '>' WHEN (V1.VALUE - V2.VALUE) < 0 THEN '<' ELSE '=' END) = E.OPERATOR THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME LEFT JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 321, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "WITH A AS (SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, V.VALUE AS VALUE1, V1.VALUE AS VALUE2 FROM EXPRESSIONS E LEFT JOIN VARIABLES V ON E.LEFT_OPERAND=V.NAME RIGHT JOIN VARIABLES V1 ON E.RIGHT_OPERAND=V1.NAME), B AS (SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR='>' THEN VALUE1>VALUE2 WHEN OPERATOR='<' THEN VALUE1<VALUE2 WHEN OPERATOR='=' THEN VALUE1=VALUE2 END AS VALUE FROM A) SELECT DISTINCT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN VALUE=1 THEN TRUE WHEN VALUE=0 THEN FALSE END AS VALUE FROM B WHERE OPERATOR IS NOT NULL"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 322, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN OPERATOR = '>' THEN IF(V.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN OPERATOR = '<' THEN IF(V.VALUE < V2.VALUE, 'TRUE', 'FALSE') ELSE IF(V.VALUE = V2.VALUE,'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V ON E.LEFT_OPERAND = V.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 323, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, (CASE WHEN E.OPERATOR = '<' THEN IF(V1.VALUE < V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '>' THEN IF(V1.VALUE > V2.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '=' THEN IF(V1.VALUE = V2.VALUE, 'TRUE', 'FALSE') END) AS VALUE FROM EXPRESSIONS E JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 324, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN OPERATOR = RELATIONSHIP THEN TRUE ELSE FALSE END AS VALUE FROM(SELECT LEFT_OPERAND, OPERATOR, RIGHT_OPERAND, CASE WHEN V1.VALUE > V2.VALUE THEN '>' WHEN V1.VALUE = V2.VALUE THEN '=' ELSE '<' END AS RELATIONSHIP FROM EXPRESSIONS E JOIN VARIABLES V1 ON E.LEFT_OPERAND = V1.NAME JOIN VARIABLES V2 ON E.RIGHT_OPERAND = V2.NAME) TEMP"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 327, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.*, IF(E.OPERATOR = '>' AND VL.VALUE > VR.VALUE, 'TRUE', IF(E.OPERATOR = '=' AND VL.VALUE = VR.VALUE, 'TRUE', IF(E.OPERATOR = '<' AND VL.VALUE < VR.VALUE, 'TRUE', 'FALSE'))) AS VALUE FROM EXPRESSIONS AS E LEFT JOIN VARIABLES AS VL ON E.LEFT_OPERAND = VL.NAME LEFT JOIN VARIABLES AS VR ON E.RIGHT_OPERAND = VR.NAME"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1440.csv", "index": 331, "schema": {"VARIABLES": {"NAME": "VARCHAR", "VALUE": "INT"}, "EXPRESSIONS": {"LEFT_OPERAND": "VARCHAR", "OPERATOR": "ENUM,<,>,=", "RIGHT_OPERAND": "VARCHAR"}}, "constraint": [{"primary": [{"value": "VARIABLES__NAME"}]}, {"primary": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "EXPRESSIONS__OPERATOR"}, {"value": "EXPRESSIONS__RIGHT_OPERAND"}]}, {"in": [{"value": "EXPRESSIONS__OPERATOR"}, [{"literal": "<"}, {"literal": ">"}, {"literal": "="}]]}, {"foreign": [{"value": "EXPRESSIONS__LEFT_OPERAND"}, {"value": "VARIABLES__NAME"}]}, {"foreign": [{"value": "EXPRESSIONS__RIGHT_OPERAND"}, {"value": "VARIABLES__NAME"}]}], "pair": ["SELECT A.*, CASE WHEN ((B.VALUE < C.VALUE AND A.OPERATOR = '<') OR (B.VALUE = C.VALUE AND A.OPERATOR = '=') OR (B.VALUE > C.VALUE AND A.OPERATOR = '>')) THEN TRUE ELSE FALSE END AS VALUE FROM EXPRESSIONS AS A JOIN VARIABLES AS B ON A.LEFT_OPERAND = B.NAME JOIN VARIABLES AS C ON A.RIGHT_OPERAND = C.NAME", "SELECT E.LEFT_OPERAND, E.OPERATOR, E.RIGHT_OPERAND, CASE WHEN E.OPERATOR = '>' THEN IF(A.VALUE>B.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '<' THEN IF(A.VALUE<B.VALUE, 'TRUE', 'FALSE') WHEN E.OPERATOR = '=' THEN IF(A.VALUE=B.VALUE, 'TRUE', 'FALSE') END AS VALUE FROM EXPRESSIONS E LEFT JOIN VARIABLES A ON A.NAME=E.LEFT_OPERAND LEFT JOIN VARIABLES B ON B.NAME=E.RIGHT_OPERAND"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
