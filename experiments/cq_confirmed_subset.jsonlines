{"file": "benchmark/leetcode/raw_data/1421.csv", "index": 81, "schema": {"NPV": {"ID": "INT", "YEAR": "INT", "NPV": "INT"}, "QUERIES": {"ID": "INT", "YEAR": "INT"}}, "constraint": [{"primary": [{"value": "NPV__ID"}, {"value": "NPV__YEAR"}]}, {"primary": [{"value": "QUERIES__ID"}, {"value": "QUERIES__YEAR"}]}, {"foreign": [{"value": "QUERIES__ID"}, {"value": "NPV__ID"}]}, {"gte": [{"value": "NPV__NPV"}, 0]}], "pair": ["SELECT Q.ID, Q.YEAR, IFNULL(N.NPV,0) AS NPV FROM QUERIES Q LEFT JOIN NPV N ON Q.ID = N.ID AND Q.YEAR = N.YEAR", "SELECT Q.YEAR,Q.ID,IFNULL(N.NPV,0) AS NPV FROM QUERIES Q LEFT JOIN NPV N ON N.YEAR = Q.YEAR AND N.ID = Q.ID"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
{"file": "benchmark/leetcode/raw_data/1421.csv", "index": 196, "schema": {"NPV": {"ID": "INT", "YEAR": "INT", "NPV": "INT"}, "QUERIES": {"ID": "INT", "YEAR": "INT"}}, "constraint": [{"primary": [{"value": "NPV__ID"}, {"value": "NPV__YEAR"}]}, {"primary": [{"value": "QUERIES__ID"}, {"value": "QUERIES__YEAR"}]}, {"foreign": [{"value": "QUERIES__ID"}, {"value": "NPV__ID"}]}, {"gte": [{"value": "NPV__NPV"}, 0]}], "pair": ["SELECT Q.ID, Q.YEAR, IFNULL(N.NPV,0) AS NPV FROM QUERIES Q LEFT JOIN NPV N ON Q.ID = N.ID AND Q.YEAR = N.YEAR", "SELECT A.YEAR,A.ID, IFNULL(NPV,0) AS NPV FROM QUERIES A LEFT JOIN NPV B ON A.YEAR=B.YEAR AND A.ID=B.ID"], "_source": "leetcode", "_gt": "GT_NEQ", "_gt_states": ["NEQ"]}
