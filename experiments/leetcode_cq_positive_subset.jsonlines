{"file": "benchmark/leetcode/raw_data/603.csv", "index": 419, "schema": {"CINEMA": {"SEAT_ID": "INT", "FREE": "BOOL"}}, "constraint": [{"inc": {"value": "CINEMA__SEAT_ID"}}, {"primary": [{"value": "CINEMA__SEAT_ID"}]}, {"in": [{"value": "CINEMA__FREE"}, [0, 1]]}, {"consec": {"value": "CINEMA__SEAT_ID"}}], "pair": ["SELECT O1.SEAT_ID FROM CINEMA O1 WHERE O1.FREE = 1 AND ((SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID - 1) = 1 OR (SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID + 1) = 1)", "WITH DATA AS ( SELECT * FROM CINEMA WHERE FREE = 1 ) SELECT SEAT_ID FROM DATA WHERE (SEAT_ID + 1 IN (SELECT SEAT_ID FROM DATA)) OR (SEAT_ID - 1 IN (SELECT SEAT_ID FROM DATA)) ORDER BY SEAT_ID"]}
{"file": "benchmark/leetcode/raw_data/603.csv", "index": 422, "schema": {"CINEMA": {"SEAT_ID": "INT", "FREE": "BOOL"}}, "constraint": [{"inc": {"value": "CINEMA__SEAT_ID"}}, {"primary": [{"value": "CINEMA__SEAT_ID"}]}, {"in": [{"value": "CINEMA__FREE"}, [0, 1]]}, {"consec": {"value": "CINEMA__SEAT_ID"}}], "pair": ["SELECT O1.SEAT_ID FROM CINEMA O1 WHERE O1.FREE = 1 AND ((SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID - 1) = 1 OR (SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID + 1) = 1)", "SELECT SEAT_ID FROM CINEMA WHERE FREE = TRUE AND (SEAT_ID + 1 IN (SELECT SEAT_ID FROM CINEMA WHERE FREE = TRUE) OR SEAT_ID - 1 IN (SELECT SEAT_ID FROM CINEMA WHERE FREE = TRUE) ) ORDER BY SEAT_ID ASC"]}
{"file": "benchmark/leetcode/raw_data/603.csv", "index": 458, "schema": {"CINEMA": {"SEAT_ID": "INT", "FREE": "BOOL"}}, "constraint": [{"inc": {"value": "CINEMA__SEAT_ID"}}, {"primary": [{"value": "CINEMA__SEAT_ID"}]}, {"in": [{"value": "CINEMA__FREE"}, [0, 1]]}, {"consec": {"value": "CINEMA__SEAT_ID"}}], "pair": ["SELECT O1.SEAT_ID FROM CINEMA O1 WHERE O1.FREE = 1 AND ((SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID - 1) = 1 OR (SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID + 1) = 1)", "SELECT SEAT_ID FROM CINEMA C1 WHERE C1.FREE = 1 AND EXISTS( SELECT * FROM CINEMA C2 WHERE FREE = 1 AND (C1.SEAT_ID = C2.SEAT_ID - 1 OR C1.SEAT_ID = C2.SEAT_ID + 1)) ORDER BY SEAT_ID"]}
{"file": "benchmark/leetcode/raw_data/1148.csv", "index": 81, "schema": {"VIEWS": {"ARTICLE_ID": "INT", "AUTHOR_ID": "INT", "VIEWER_ID": "INT", "VIEW_DATE": "DATE"}}, "constraint": null, "pair": ["SELECT DISTINCT AUTHOR_ID AS ID FROM VIEWS WHERE AUTHOR_ID = VIEWER_ID ORDER BY ID", "SELECT DISTINCT(AUTHOR_ID) ID FROM VIEWS T1 WHERE EXISTS(SELECT * FROM VIEWS T2 WHERE T1.ARTICLE_ID = T2.ARTICLE_ID AND T1.AUTHOR_ID = T2.VIEWER_ID) ORDER BY ID"]}
{"file": "benchmark/leetcode/raw_data/1148.csv", "index": 123, "schema": {"VIEWS": {"ARTICLE_ID": "INT", "AUTHOR_ID": "INT", "VIEWER_ID": "INT", "VIEW_DATE": "DATE"}}, "constraint": null, "pair": ["SELECT DISTINCT AUTHOR_ID AS ID FROM VIEWS WHERE AUTHOR_ID = VIEWER_ID ORDER BY ID", "SELECT DISTINCT O.AUTHOR_ID AS ID FROM VIEWS O WHERE EXISTS(SELECT I.VIEWER_ID FROM VIEWS I WHERE (I.AUTHOR_ID = I.VIEWER_ID) AND (I.ARTICLE_ID = O.ARTICLE_ID)) ORDER BY O.AUTHOR_ID"]}
{"file": "benchmark/leetcode/raw_data/1148.csv", "index": 136, "schema": {"VIEWS": {"ARTICLE_ID": "INT", "AUTHOR_ID": "INT", "VIEWER_ID": "INT", "VIEW_DATE": "DATE"}}, "constraint": null, "pair": ["SELECT DISTINCT AUTHOR_ID AS ID FROM VIEWS WHERE AUTHOR_ID = VIEWER_ID ORDER BY ID", "SELECT DISTINCT AUTHOR_ID AS ID FROM VIEWS WHERE AUTHOR_ID IN (SELECT AUTHOR_ID FROM VIEWS WHERE AUTHOR_ID = VIEWER_ID) ORDER BY AUTHOR_ID"]}
{"file": "benchmark/leetcode/raw_data/1148.csv", "index": 138, "schema": {"VIEWS": {"ARTICLE_ID": "INT", "AUTHOR_ID": "INT", "VIEWER_ID": "INT", "VIEW_DATE": "DATE"}}, "constraint": null, "pair": ["SELECT DISTINCT AUTHOR_ID AS ID FROM VIEWS WHERE AUTHOR_ID = VIEWER_ID ORDER BY ID", "SELECT DISTINCT AUTHOR_ID AS ID FROM VIEWS WHERE AUTHOR_ID IN ( SELECT V.VIEWER_ID FROM VIEWS AS V WHERE V.AUTHOR_ID=V.VIEWER_ID ) ORDER BY AUTHOR_ID"]}
{"file": "benchmark/leetcode/raw_data/1148.csv", "index": 145, "schema": {"VIEWS": {"ARTICLE_ID": "INT", "AUTHOR_ID": "INT", "VIEWER_ID": "INT", "VIEW_DATE": "DATE"}}, "constraint": null, "pair": ["SELECT DISTINCT AUTHOR_ID AS ID FROM VIEWS WHERE AUTHOR_ID = VIEWER_ID ORDER BY ID", "SELECT DISTINCT V1.AUTHOR_ID AS ID FROM VIEWS V1 WHERE EXISTS (SELECT 1 FROM VIEWS V2 WHERE V2.ARTICLE_ID=V1.ARTICLE_ID AND V1.AUTHOR_ID=V2.VIEWER_ID) ORDER BY 1"]}
