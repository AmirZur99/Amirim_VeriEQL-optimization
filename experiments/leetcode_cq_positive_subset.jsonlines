{"file": "benchmark/leetcode/raw_data/603.csv", "index": 395, "schema": {"CINEMA": {"SEAT_ID": "INT", "FREE": "BOOL"}}, "constraint": [{"inc": {"value": "CINEMA__SEAT_ID"}}, {"primary": [{"value": "CINEMA__SEAT_ID"}]}, {"in": [{"value": "CINEMA__FREE"}, [0, 1]]}, {"consec": {"value": "CINEMA__SEAT_ID"}}], "pair": ["SELECT O1.SEAT_ID FROM CINEMA O1 WHERE O1.FREE = 1 AND ((SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID - 1) = 1 OR (SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID + 1) = 1)", "WITH T1 AS( SELECT *, SEAT_ID-1 FROM CINEMA WHERE FREE=1 ) SELECT T1.SEAT_ID FROM T1 WHERE T1.SEAT_ID-1 IN (SELECT T1.SEAT_ID FROM T1) OR T1.SEAT_ID+1 IN (SELECT T1.SEAT_ID FROM T1)"]}
{"file": "benchmark/leetcode/raw_data/603.csv", "index": 405, "schema": {"CINEMA": {"SEAT_ID": "INT", "FREE": "BOOL"}}, "constraint": [{"inc": {"value": "CINEMA__SEAT_ID"}}, {"primary": [{"value": "CINEMA__SEAT_ID"}]}, {"in": [{"value": "CINEMA__FREE"}, [0, 1]]}, {"consec": {"value": "CINEMA__SEAT_ID"}}], "pair": ["SELECT O1.SEAT_ID FROM CINEMA O1 WHERE O1.FREE = 1 AND ((SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID - 1) = 1 OR (SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID + 1) = 1)", "SELECT SEAT_ID FROM CINEMA WHERE FREE = 1 AND ( (SEAT_ID - 1) IN (SELECT SEAT_ID FROM CINEMA WHERE FREE = 1) OR (SEAT_ID + 1) IN (SELECT SEAT_ID FROM CINEMA WHERE FREE = 1) ) ORDER BY SEAT_ID"]}
