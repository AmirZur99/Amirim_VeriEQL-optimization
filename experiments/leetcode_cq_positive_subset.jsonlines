{"file": "benchmark/leetcode/raw_data/1378.csv", "index": 311, "schema": {"EMPLOYEES": {"ID": "INT", "NAME": "VARCHAR"}, "EMPLOYEEUNI": {"ID": "INT", "UNIQUE_ID": "INT"}}, "constraint": [{"primary": [{"value": "EMPLOYEES__ID"}]}, {"primary": [{"value": "EMPLOYEEUNI__ID"}, {"value": "EMPLOYEEUNI__UNIQUE_ID"}]}, {"foreign": [{"value": "EMPLOYEEUNI__ID"}, {"value": "EMPLOYEES__ID"}]}], "pair": ["SELECT E2.UNIQUE_ID, E1.NAME FROM EMPLOYEES E1 LEFT JOIN EMPLOYEEUNI E2 ON E1.ID = E2.ID", "SELECT CASE WHEN E.ID IN (U.ID) THEN UNIQUE_ID ELSE NULL END AS UNIQUE_ID, E.NAME FROM EMPLOYEES AS E LEFT JOIN EMPLOYEEUNI AS U ON E.ID = U.ID"]}
{"file": "benchmark/leetcode/raw_data/1421.csv", "index": 255, "schema": {"NPV": {"ID": "INT", "YEAR": "INT", "NPV": "INT"}, "QUERIES": {"ID": "INT", "YEAR": "INT"}}, "constraint": [{"primary": [{"value": "NPV__ID"}, {"value": "NPV__YEAR"}]}, {"primary": [{"value": "QUERIES__ID"}, {"value": "QUERIES__YEAR"}]}, {"foreign": [{"value": "QUERIES__ID"}, {"value": "NPV__ID"}]}, {"gte": [{"value": "NPV__NPV"}, 0]}], "pair": ["SELECT Q.ID, Q.YEAR, IFNULL(N.NPV,0) AS NPV FROM QUERIES Q LEFT JOIN NPV N ON Q.ID = N.ID AND Q.YEAR = N.YEAR", "SELECT Q.ID, Q.YEAR, CASE WHEN Q.ID IN (N.ID) AND Q.YEAR IN (N.YEAR) THEN N.NPV ELSE 0 END AS NPV FROM QUERIES AS Q LEFT JOIN NPV AS N ON Q.ID = N.ID AND Q.YEAR = N.YEAR"]}
{"file": "benchmark/leetcode/raw_data/1421.csv", "index": 377, "schema": {"NPV": {"ID": "INT", "YEAR": "INT", "NPV": "INT"}, "QUERIES": {"ID": "INT", "YEAR": "INT"}}, "constraint": [{"primary": [{"value": "NPV__ID"}, {"value": "NPV__YEAR"}]}, {"primary": [{"value": "QUERIES__ID"}, {"value": "QUERIES__YEAR"}]}, {"foreign": [{"value": "QUERIES__ID"}, {"value": "NPV__ID"}]}, {"gte": [{"value": "NPV__NPV"}, 0]}], "pair": ["SELECT Q.ID, Q.YEAR, IFNULL(N.NPV,0) AS NPV FROM QUERIES Q LEFT JOIN NPV N ON Q.ID = N.ID AND Q.YEAR = N.YEAR", "WITH A AS ( SELECT Q.ID ,Q.YEAR , CASE WHEN (Q.ID,Q.YEAR) IN (SELECT Q.ID,Q.YEAR FROM NPV) THEN 1 ELSE 0 END AS NPV FROM QUERIES Q ) SELECT A.ID , A.YEAR , IFNULL(B.NPV,0) AS NPV FROM A LEFT JOIN (SELECT * FROM NPV) B ON A.ID = B.ID AND A.YEAR = B.YEAR"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 158, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT ACCOUNT_ID FROM LOGINFO WHERE ACCOUNT_ID IN ( SELECT L1.ACCOUNT_ID FROM LOGINFO L1 LEFT JOIN LOGINFO L2 ON L1.ACCOUNT_ID = L2.ACCOUNT_ID AND L1.IP_ADDRESS<>L2.IP_ADDRESS WHERE (L1.LOGIN=L2.LOGIN) OR(L1.LOGOUT=L2.LOGOUT) OR(L1.LOGIN>L2.LOGIN AND L1.LOGIN<=L2.LOGOUT) OR(L1.LOGIN<L2.LOGIN AND L1.LOGOUT>=L2.LOGIN))"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 288, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT ACCOUNT_ID FROM LOGINFO A WHERE EXISTS ( SELECT 1 FROM LOGINFO B WHERE B.ACCOUNT_ID = A.ACCOUNT_ID AND B.IP_ADDRESS != A.IP_ADDRESS AND ((B.LOGIN BETWEEN A.LOGIN AND A.LOGOUT) OR (A.LOGIN BETWEEN B.LOGIN AND B.LOGOUT)) )"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 410, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT ACCOUNT_ID FROM LOGINFO WHERE ACCOUNT_ID IN (SELECT L1.ACCOUNT_ID FROM LOGINFO L1 JOIN LOGINFO L2 ON L1.ACCOUNT_ID=L2.ACCOUNT_ID AND L1.IP_ADDRESS!=L2.IP_ADDRESS AND (L1.LOGIN BETWEEN L2.LOGIN AND L2.LOGOUT OR L2.LOGIN BETWEEN L1.LOGIN AND L1.LOGOUT))"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 421, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT ACCOUNT_ID FROM LOGINFO A WHERE EXISTS ( SELECT * FROM LOGINFO B WHERE A.ACCOUNT_ID = B.ACCOUNT_ID AND A.IP_ADDRESS != B.IP_ADDRESS AND B.LOGIN <= A.LOGIN AND A.LOGIN <= B.LOGOUT )"]}
{"file": "benchmark/leetcode/raw_data/1747.csv", "index": 482, "schema": {"LOGINFO": {"ACCOUNT_ID": "INT", "IP_ADDRESS": "INT", "LOGIN": "TIME", "LOGOUT": "TIME"}}, "constraint": [{"lt": [{"value": "LOGINFO__LOGIN"}, {"value": "LOGINFO__LOGOUT"}]}], "pair": ["SELECT DISTINCT I1.ACCOUNT_ID FROM LOGINFO AS I1 JOIN LOGINFO AS I2 ON (I1.ACCOUNT_ID = I2.ACCOUNT_ID AND I1.IP_ADDRESS <> I2.IP_ADDRESS AND I2.LOGIN BETWEEN I1.LOGIN AND I1.LOGOUT)", "SELECT DISTINCT ACCOUNT_ID FROM LOGINFO L WHERE EXISTS ( SELECT ACCOUNT_ID FROM LOGINFO WHERE (ACCOUNT_ID = L.ACCOUNT_ID AND IP_ADDRESS <> L.IP_ADDRESS) AND ((LOGIN >= L.LOGIN &AMP;&AMP; LOGIN <= L.LOGOUT) OR (LOGOUT >= L.LOGIN &AMP;&AMP; LOGOUT <= L.LOGOUT) OR (LOGIN <= L.LOGIN &AMP;&AMP; LOGOUT >= L.LOGOUT)) )"]}
{"file": "benchmark/leetcode/raw_data/1809.csv", "index": 6, "schema": {"PLAYBACK": {"SESSION_ID": "INT", "CUSTOMER_ID": "INT", "START_TIME": "INT", "END_TIME": "INT"}, "ADS": {"AD_ID": "INT", "CUSTOMER_ID": "INT", "TIMESTAMP": "INT"}}, "constraint": [{"primary": [{"value": "PLAYBACK__SESSION_ID"}]}, {"primary": [{"value": "ADS__AD_ID"}]}, {"lte": [{"value": "PLAYBACK__START_TIME"}, {"value": "PLAYBACK__END_TIME"}]}, {"foreign": [{"value": "ADS__CUSTOMER_ID"}, {"value": "PLAYBACK__CUSTOMER_ID"}]}], "pair": ["SELECT SESSION_ID FROM PLAYBACK PB LEFT JOIN ADS AD ON PB.CUSTOMER_ID = AD.CUSTOMER_ID AND AD.TIMESTAMP BETWEEN START_TIME AND END_TIME WHERE AD.CUSTOMER_ID IS NULL", "SELECT DISTINCT SESSION_ID FROM PLAYBACK WHERE NOT SESSION_ID IN (SELECT DISTINCT P.SESSION_ID FROM PLAYBACK P JOIN ADS A ON P.CUSTOMER_ID = A.CUSTOMER_ID WHERE A.TIMESTAMP BETWEEN P.START_TIME AND P.END_TIME)"]}
