{"file": "benchmark/leetcode/raw_data/603.csv", "index": 81, "schema": {"CINEMA": {"SEAT_ID": "INT", "FREE": "BOOL"}}, "constraint": [{"inc": {"value": "CINEMA__SEAT_ID"}}, {"primary": [{"value": "CINEMA__SEAT_ID"}]}, {"in": [{"value": "CINEMA__FREE"}, [0, 1]]}, {"consec": {"value": "CINEMA__SEAT_ID"}}], "pair": ["SELECT O1.SEAT_ID FROM CINEMA O1 WHERE O1.FREE = 1 AND ((SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID - 1) = 1 OR (SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID + 1) = 1)", "SELECT C1.SEAT_ID FROM (SELECT SEAT_ID FROM CINEMA WHERE FREE=1) AS C1 WHERE C1.SEAT_ID +1 IN (SELECT SEAT_ID FROM CINEMA WHERE FREE=1) OR C1.SEAT_ID-1 IN (SELECT SEAT_ID FROM CINEMA WHERE FREE=1) ORDER BY C1.SEAT_ID"]}
{"file": "benchmark/leetcode/raw_data/603.csv", "index": 84, "schema": {"CINEMA": {"SEAT_ID": "INT", "FREE": "BOOL"}}, "constraint": [{"inc": {"value": "CINEMA__SEAT_ID"}}, {"primary": [{"value": "CINEMA__SEAT_ID"}]}, {"in": [{"value": "CINEMA__FREE"}, [0, 1]]}, {"consec": {"value": "CINEMA__SEAT_ID"}}], "pair": ["SELECT O1.SEAT_ID FROM CINEMA O1 WHERE O1.FREE = 1 AND ((SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID - 1) = 1 OR (SELECT FREE FROM CINEMA O2 WHERE O2.SEAT_ID = O1.SEAT_ID + 1) = 1)", "SELECT C1.SEAT_ID FROM CINEMA C1 WHERE C1.FREE = 1 AND EXISTS (SELECT * FROM CINEMA C2 WHERE ((C2.SEAT_ID + 1 = C1.SEAT_ID) OR (C2.SEAT_ID - 1 = C1.SEAT_ID)) AND C2.FREE = 1) ORDER BY C1.SEAT_ID ASC"]}
